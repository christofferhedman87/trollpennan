diff --git a/src/spel/ui/BokSvar.tsx b/src/spel/ui/BokSvar.tsx
new file mode 100644
index 0000000..0db82fc
--- /dev/null
+++ b/src/spel/ui/BokSvar.tsx
@@ -0,0 +1,47 @@
+// P1: barnets svarsyta i boken – "Menade du …?" och "Pennan behöver …". Ligger UTANFÖR bokens skrollyta (bok-mitt),
+// direkt ovanför skrivrutan, så att knapparna alltid syns hela och aldrig hamnar under rutan (granskningen 1.2, K4).
+import type { ForslagKort } from "@/tolk/typer.ts";
+import type { Forslag } from "./typer.ts";
+import "./bok-p1.css";
+
+type Props = {
+  forslag: Forslag | null;
+  valjForslag: (kortet: ForslagKort) => void;
+  nejForslag: () => void;
+  behover: { text: string; djur: { id: string; visa: string }[] } | null;
+  utfor: (raw: string, opt: { hand: boolean; inteGuld?: string[] }) => void;
+};
+
+export function BokSvar({ forslag, valjForslag, nejForslag, behover, utfor }: Props) {
+  if (!forslag && !behover) return null;
+  return (
+    <div className="bok-svar" aria-live="polite">
+      {forslag ? (
+        <div className="forslag" data-testid="forslag">
+          <p>{forslag.text}</p>
+          <div className="rad-kort">
+            {forslag.forslag.map((f) => (
+              <button key={f.id} type="button" className="kort" data-testid={`forslag-${f.id}`} onClick={() => valjForslag(f)}>
+                {f.visa}
+              </button>
+            ))}
+            <button type="button" className="nej" data-testid="nej" onClick={nejForslag}>
+              Nej
+            </button>
+          </div>
+        </div>
+      ) : behover ? (
+        <div className="behover" data-testid="behover">
+          <p>{behover.text}</p>
+          <div className="rad-kort">
+            {behover.djur.map((d) => (
+              <button key={d.id} type="button" className="kort" data-testid={`prova-${d.id}`} onClick={() => utfor(d.id, { hand: false })}>
+                {d.visa}
+              </button>
+            ))}
+          </div>
+        </div>
+      ) : null}
+    </div>
+  );
+}
diff --git a/src/spel/ui/bok-p1.css b/src/spel/ui/bok-p1.css
new file mode 100644
index 0000000..42240c8
--- /dev/null
+++ b/src/spel/ui/bok-p1.css
@@ -0,0 +1,15 @@
+/* P1 – boken utan hinder (rundor/P1-boken/RITNING.md). Egen fil så att styles.css (B6.3/B6.6) inte får konflikter. */
+/* Svarsytan ligger mellan skrollytan och skrivrutan och krymper aldrig bort. */
+.bok .bok-svar{flex:0 0 auto;max-height:42dvh;overflow:auto;overscroll-behavior:contain;padding:8px 10px 6px;border-top:2px solid var(--color-paper-deep);background:var(--color-paper)}
+.bok .bok-svar .forslag,.bok .bok-svar .behover{flex:none;min-height:0;padding:0;overflow:visible}
+.bok .bok-svar p{margin:0 0 8px;font-size:1.125rem;font-weight:800;line-height:1.3}
+.bok .bok-svar .rad-kort{display:flex;flex-wrap:wrap;gap:8px}
+.bok .bok-svar .kort,.bok .bok-svar .nej{min-height:52px;min-width:64px}
+/* Skrivrutan är tryckbar: den öppnar tangentbordet. */
+.bok .remsa{cursor:text;touch-action:manipulation}
+/* Kontrast ≥ 4,5:1 (granskningen: 3,75:1) */
+.bok .ledtrad-hint{color:var(--color-moss-deep);font-size:1rem}
+.bok .flik.pa{background:var(--color-moss-deep)}
+/* Platsnamn och "Till ängen" i en rad under HUD:en – låg över stjärnknappen (9×8 px) på 375 px. */
+body .plats-resa{top:66px;flex-direction:row;gap:8px}
+body .plats-namn,body .plats-hem{white-space:nowrap}
