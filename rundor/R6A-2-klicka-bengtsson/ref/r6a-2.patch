+  if (!uppdrag) return null;
+  const namn = uppdrag.givare ? NPC[uppdrag.givare]?.namn : undefined;
+  return (
+    <p className="uppdrag-remsa" data-testid="uppdrag-remsa" data-uppdrag={uppdrag.id}>
