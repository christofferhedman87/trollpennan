+export function synligAndel(saker: readonly { id: string; z: number; r: Ruta; x?: number; h?: number }[]): Record<string, number> {
+  const ut: Record<string, number> = {};
+  for (const s of saker) {
+    let t = 0;
+    for (const o of saker) if (o !== s && (framfor(o.z, s) || sammaDjup(o, s))) t += tacker(o.r, s.r);
+    ut[s.id] = Math.max(0, 1 - t);
+  }
+  return ut;
+}
