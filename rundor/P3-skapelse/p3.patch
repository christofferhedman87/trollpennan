--- /dev/null
+++ b/src/spel/landning.ts
@@ -0,0 +1,39 @@
+// P3: den nya skapelsen landar längst fram och syns. Ren logik (ingen three), testas i Node. Värdena står i data/miljo.json `landning`.
+import type { Sparad } from "./brygga.ts";
+import { MILJO } from "./miljo.ts";
+
+export const LANDNING = MILJO.landning;
+
+/** Den senast skapade (störst `skapad`, vid lika det största uid) – den som landar framme. */
+export function nyast<T extends Pick<Sparad, "uid" | "skapad">>(rad: T[]): T | undefined {
+  let b: T | undefined;
+  for (const d of rad) if (!b || d.skapad > b.skapad || (d.skapad === b.skapad && d.uid > b.uid)) b = d;
+  return b;
+}
+
+/** true = en annan skapelse på (x, z) skulle stå framför landningsplatsen och skymma den nya skapelsen. */
+export function skymmerLandning(x: number, z: number, l = LANDNING): boolean {
+  return z > l.z - l.fri_z && Math.abs(x - l.x) < l.fri_x;
+}
+
+/** Platser för de andra: ordningen behålls, men platser som skymmer landningen hoppas över (de glider bakåt). */
+export function utanSkymning(platser: [number, number][], l = LANDNING): [number, number][] {
+  return platser.filter(([x, z]) => !skymmerLandning(x, z, l));
+}
+
+/**
+ * P3: var en sak bredvid ett djur står ("en kanin med en hink"), relativt djuret. Förut alltid höger/vänster om djuret,
+ * så saken kunde hamna i dammen. Nu prövas sidan, andra sidan och framför; den första där sakens fot är torr vinner.
+ * `torr(wx, wz)` = platsens regel (platsYta torrKropp med sakens kant); saknas den gäller första förslaget.
+ */
+export function sakLage(x: number, z: number, onskad: [number, number], torr?: (wx: number, wz: number) => boolean): [number, number] {
+  const [dx, dz] = onskad;
+  const forslag: [number, number][] = [[dx, dz], [-dx, dz], [dx * 0.4, dz + 0.55], [-dx * 0.4, dz + 0.55], [dx, dz + 0.6], [-dx, dz + 0.6]];
+  if (!torr) return forslag[0]!;
+  return forslag.find(([ox, oz]) => torr(x + ox, z + oz)) ?? forslag[0]!;
+}
+
+/** true = en skapelse (halva bredden hD) på (x, z) står framför den nya på `ny` (halva bredden hN) och överlappar i sidled. */
+export function skymmerNy(x: number, z: number, hD: number, ny: [number, number], hN: number, l = LANDNING): boolean {
+  return z > ny[1] - l.fri_z && Math.abs(x - ny[0]) < hN + hD + 0.1;
+}
