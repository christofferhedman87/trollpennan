+test("P3: den nya skapelsen landar längst fram och ingen annan står framför den", () => {
+  const ang = platsMed(START_PLATS);
+  for (const n of [2, 4, 7, 10, 12]) {
+    const alla = Array.from({ length: n }, (_, i) => spar(`d${i}`, ["kanin", "hund", "katt", "elefant", "häst", "gris", "ko", "giraff", "lejon", "björn", "fisk", "kanin"][i]!, 1000 + i));
+    const ny = nyast(alla as { uid: string; skapad: number }[])!;
+    const lagen = new Map((alla as { uid: string }[]).map((d) => [d.uid, djurPlats(d as never, alla, ang)]));
+    const p = lagen.get(ny.uid)!;
+    if (simmar((alla as { uid: string; kropp: string }[]).find((d) => d.uid === ny.uid)!.kropp, [])) continue;
+    const nyK = (ny as unknown as { kropp: string }).kropp;
+    // små och mellanstora landar på landningsplatsen; de stora (dammens siktzon) närmast den där dammen syns
+    if (halvBredd(nyK) < 0.6) assert.ok(Math.abs(p[0] - LANDNING.x) < 0.35 && Math.abs(p[2] - LANDNING.z) < 0.35, `${n}: den nya (${nyK}) står i (${p[0]}, ${p[2]})`);
+    const nyR = skarmRuta(p[0], 0, p[2], halvBredd(nyK), malhojd(nyK));
+    assert.ok(nyR.x0 >= -5 && nyR.x1 <= 380, `${n}: den nya utanför bilden`);
+    for (const [uid, q] of lagen) {
