+/** P3 (r83a): skärmrutorna på en plats som spelet ritar dem (trängsel- och synskala), med guiden framför allt. */
+function platsRutor(lista: string[], plats: Plats) {
+  const alla = lista.map((k, i) => spar(`s${i}-${k}`, k, 1000 + i)) as unknown as Sparad[];
+  const lagen = alla.map((d) => djurPlats(d, alla, plats));
+  const rutor = alla.map((d, i) => {
+    const k = trangSkala(d.uid);
+    const [x, y, z] = lagen[i]!;
+    const kr = { halv: halvBredd(d.kropp, 1) * k, hojd: malhojd(d.kropp) * k, skala: (wz: number) => synSkala(d.kropp, k, wz) };
+    return { d, x, y, z, k, r: kroppRuta(kr, x, z), flyg: flygare(d, plats), sim: simmare(d, plats) };
+  });
+  const hinder = (SYN?.skarm_hinder ?? []).map((h, i) => ({ id: `hinder-${i}`, z: FRAMST, r: h }));
+  const andel = synligAndel([...hinder, ...rutor.filter((q) => !q.flyg).map((q) => ({ id: q.d.uid, x: q.x, h: halvBredd(q.d.kropp, 1) * q.k * synSkala(q.d.kropp, q.k, q.z), z: q.z, r: q.r }))]);
+  return { rutor, andel, ryms: platsRymms(alla, plats) };
+}
