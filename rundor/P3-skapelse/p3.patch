+++ b/src/spel/plagg/Plagg.tsx
@@ -0,0 +1,173 @@
+// P3: kläderna (data/plagg.json) ritas PÅ skapelsen, inte bredvid den på marken. Kroppsdelarna härleds ur skapelsens
+// egna meshar (plagg/data.ts kroppsdelar), mäts om när kroppen byts (procedurkropp → GLB) och följer huvudets ben
+// när modellen har ett. En komponent för alla plagg; inget per plagg i koden.
+import { useGLTF } from "@react-three/drei";
+import { useFrame } from "@react-three/fiber";
+import { Suspense, useMemo, useRef, useState, type RefObject } from "react";
+import { SkeletonUtils } from "three-stdlib";
+import * as THREE from "three";
+import type { Sparad } from "../brygga.ts";
+import { entitet, framVinkel, modellUrl } from "../entiteter.ts";
+import { belysScen } from "../belys.ts";
+import { fargaKlon, metallNoll } from "../gltfDjur.tsx";
+import { arPlagg, kroppsdelar, MODELLER, plaggLage, plaggRegel, type Kroppsdelar, type Punkt } from "./data.ts";
+
+declare global {
+  interface Window {
+    /** P3, för prov: per skapelse, varje plagg och kroppen som världsrutor [min, max]. */
+    __tredPlagg?: Record<string, { id: string; del: string; kropp: [Punkt, Punkt]; plagg: [Punkt, Punkt] }[]>;
+  }
+}
+
+const MAX_PER_MESH = 900;
+const _v = new THREE.Vector3();
+const _inv = new THREE.Matrix4();
+
+/** Kroppens punkter i `rum`-gruppens lokala koordinater (skinnade meshar i sin nuvarande pose). */
+function punkterUr(kropp: THREE.Object3D, rum: THREE.Object3D): { xyz: Float32Array; sign: string } {
+  rum.updateWorldMatrix(true, true);
+  _inv.copy(rum.matrixWorld).invert();
+  const ut: number[] = [];
+  const sign: string[] = [];
+  kropp.traverseVisible((o) => {
+    const m = o as THREE.Mesh;
+    if (!m.isMesh || !m.geometry?.attributes?.position) return;
+    const pos = m.geometry.attributes.position;
+    sign.push(`${m.geometry.uuid}:${pos.count}`);
+    const steg = Math.max(1, Math.ceil(pos.count / MAX_PER_MESH));
+    const skinn = (m as THREE.SkinnedMesh).isSkinnedMesh ? (m as THREE.SkinnedMesh) : null;
+    for (let i = 0; i < pos.count; i += steg) {
+      _v.fromBufferAttribute(pos, i);
+      if (skinn) skinn.applyBoneTransform(i, _v);
+      _v.applyMatrix4(m.matrixWorld).applyMatrix4(_inv);
+      ut.push(_v.x, _v.y, _v.z);
+    }
+  });
+  return { xyz: new Float32Array(ut), sign: sign.join("|") };
+}
+
+function huvudBen(kropp: THREE.Object3D): THREE.Object3D | null {
+  let hit: THREE.Object3D | null = null;
+  kropp.traverse((o) => {
+    if (!hit && (o as THREE.Bone).isBone && /head|huvud/i.test(o.name)) hit = o;
+  });
+  return hit;
+}
+
+export function PlaggPaKropp({ spec, kropp }: { spec: Sparad; kropp: RefObject<THREE.Group | null> }) {
+  const ids = useMemo(() => [...new Set(spec.tillbehor.map((t) => t.id).filter(arPlagg))], [spec.tillbehor]);
+  const rum = useRef<THREE.Group>(null);
+  const huvud = useRef<THREE.Group>(null);
+  const [delar, setDelar] = useState<Kroppsdelar | null>(null);
+  const sign = useRef("");
+  const ben = useRef<{ ben: THREE.Object3D; vila: THREE.Vector3 } | null>(null);
+  const ram = useRef(0);
+  useFrame(() => {
+    const k = kropp.current;
+    const r = rum.current;
+    if (!k || !r || !ids.length) return;
+    ram.current += 1;
+    // mät om när kroppen byts (procedurkroppen ersätts av modellen när den har laddats)
+    if (ram.current % 12 === 1) {
+      let s = "";
+      k.traverseVisible((o) => {
+        const m = o as THREE.Mesh;
+        if (m.isMesh) s += m.geometry?.uuid ?? "";
+      });
+      if (s && s !== sign.current) {
+        const { xyz } = punkterUr(k, r);
+        const ny = kroppsdelar(xyz, MODELLER[spec.kropp] ?? {});
+        if (ny) {
+          sign.current = s;
+          setDelar(ny);
+          const b = huvudBen(k);
+          ben.current = b ? { ben: b, vila: r.worldToLocal(b.getWorldPosition(new THREE.Vector3())) } : null;
+        }
+      }
+    }
+    // huvudets plagg följer huvudbenet (idle, dans) när modellen har ett
+    const h = huvud.current;
+    if (h && ben.current) {
+      const nu = r.worldToLocal(ben.current.ben.getWorldPosition(_v));
+      h.position.copy(nu).sub(ben.current.vila);
+    }
+    if (typeof window !== "undefined" && window.__tredPlagg && ram.current % 15 === 0) {
+      const kb = new THREE.Box3().setFromObject(k);
+      const rad: NonNullable<Window["__tredPlagg"]>[string] = [];
+      r.traverse((o) => {
+        const id = o.userData.plagg as string | undefined;
+        if (!id) return;
+        const pb = new THREE.Box3().setFromObject(o);
+        if (pb.isEmpty() || kb.isEmpty()) return;
+        rad.push({ id, del: plaggRegel(id)?.del ?? "", kropp: [kb.min.toArray(), kb.max.toArray()], plagg: [pb.min.toArray(), pb.max.toArray()] });
+      });
+      window.__tredPlagg[spec.uid] = rad;
+    }
+  });
+  if (!ids.length) return null;
+  const farg = (id: string) => spec.tillbehor.find((t) => t.id === id)?.farg ?? null;
+  return (
+    <group ref={rum} name="plagg">
+      {delar ? (
+        <>
+          <group ref={huvud}>
+            {ids.filter((id) => plaggRegel(id)?.del === "huvud").map((id) => (
+              <Suspense key={id} fallback={null}>
+                <EttPlagg id={id} farg={farg(id)} delar={delar} />
+              </Suspense>
+            ))}
+          </group>
+          {ids.filter((id) => plaggRegel(id)?.del !== "huvud").map((id) => (
+            <Suspense key={id} fallback={null}>
+              <EttPlagg id={id} farg={farg(id)} delar={delar} />
+            </Suspense>
+          ))}
+        </>
+      ) : null}
+    </group>
+  );
+}
+
+/** Ett plagg: modellen vriden med bredsidan mot kameran, botten i y = 0 och mitten i x/z = 0, sedan läge och skala ur kroppsdelen. */
+function EttPlagg({ id, farg, delar }: { id: string; farg: string | null; delar: Kroppsdelar }) {
+  const gltf = useGLTF(modellUrl(id)!);
+  const { klon, box } = useMemo(() => {
+    belysScen(gltf.scene);
+    const c = SkeletonUtils.clone(gltf.scene) as THREE.Object3D;
+    metallNoll(c);
+    if (farg) fargaKlon(c, { kropp: id, farg } as Sparad);
+    const r = plaggRegel(id);
+    const ax = entitet(id)?.framAxel;
+    c.updateMatrixWorld(true);
+    let b = new THREE.Box3().setFromObject(c);
+    // bredsidan mot kameran: ett plagg för bålen/halsen/höften som är djupare än brett ligger på sidan i sin fil
+    const vrid = ax ? framVinkel(ax) : r && r.del !== "huvud" && r.del !== "fotter" && b.max.z - b.min.z > 1.3 * (b.max.x - b.min.x) ? Math.PI / 2 : 0;
+    const v = new THREE.Group();
+    v.rotation.y = vrid;
+    v.add(c);
+    v.updateMatrixWorld(true);
+    b = new THREE.Box3().setFromObject(v);
+    const inre = new THREE.Group();
+    inre.add(v);
+    v.position.set(-(b.min.x + b.max.x) / 2, -b.min.y, -(b.min.z + b.max.z) / 2);
+    return { klon: inre, box: [b.max.x - b.min.x, b.max.y - b.min.y, b.max.z - b.min.z] as Punkt };
+  }, [gltf.scene, id, farg]);
+  const lage = plaggLage(id, delar, box);
+  const par = lage?.par ?? 1;
+  const andra = useMemo(() => (par > 1 ? SkeletonUtils.clone(klon) : null), [klon, par]);
+  if (!lage) return null;
+  const [x, y, z] = lage.pos;
+  const isar = lage.par > 1 ? (box[0] * lage.skala) / 2 + 0.02 : 0;
+  return (
+    <group position={[x, y, z]} scale={lage.skala} userData={{ plagg: id }}>
+      <group position={[-isar / lage.skala, 0, 0]}>
+        <primitive object={klon} />
+      </group>
+      {andra ? (
+        <group position={[isar / lage.skala, 0, 0]}>
+          <primitive object={andra} />
+        </group>
+      ) : null}
+    </group>
+  );
+}
diff --git a/src/spel/plagg/data.ts b/src/spel/plagg/data.ts
