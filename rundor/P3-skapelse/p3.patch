@@ -0,0 +1,61 @@
+// P3: hur stora saker och byggnader får skymma varandra på skärmen. En regel för alla, inga specialfall per modell.
+// Varje sak syns till minst (1 − max_skymd) av sin skärmruta (data/storlek.json bak.max_skymd): summan av hur mycket
+// de som står framför (eller på samma djup) täcker den. Rutan räknas med den stående kameran (skarm.ts), fot på marken, halva bredden
+// och höjden ur modellens mått.
+import { skarmRuta, tacker, type Ruta } from "./skarm.ts";
+
+export type Placerad = { x: number; z: number; h: number; hojd: number; r: Ruta; tackt: number };
+
+/** Skärmrutan för en sak med fot i (x, 0, z): lådan x ± halv, z ± djup (som standard lika djup som bred), 0 … hojd. */
+export function sakRuta(x: number, z: number, halv: number, hojd: number, djup = halv): Ruta {
+  const f = skarmRuta(x, 0, z + djup, halv, hojd);
+  const b = skarmRuta(x, 0, z - djup, halv, hojd);
+  return { x0: Math.min(f.x0, b.x0), x1: Math.max(f.x1, b.x1), y0: Math.min(f.y0, b.y0), y1: Math.max(f.y1, b.y1) };
+}
+
+/** Om sakens djup gör den till "framför" den andra (närmare kameran). */
+const framfor = (z: number, o: { z: number }) => z > o.z + 0.05;
+/** P3 (Doodle r83a): på samma djup skymmer de varandra åt båda hållen bara om kropparna går in i varandra i sidled
+ *  (katterna på sanden). Står de bredvid varandra (byggnaderna i en rad) räknas det inte. */
+type Sida = { z: number; x?: number; h?: number };
+const sammaDjup = (a: Sida, o: Sida) =>
+  Math.abs(a.z - o.z) <= 0.05 && a.x !== undefined && o.x !== undefined && a.h !== undefined && o.h !== undefined && Math.abs(a.x - o.x) < a.h + o.h - 1e-6;
+
+/**
+ * Sämsta skymningen om en ny sak (rutan r, djup z) ställs bland de placerade: max av (a) hur mycket de framför täcker
+ * den nya och (b) för varje sak bakom, det den redan var täckt plus det den nya täcker. 0 = ingen skyms, 1 = helt.
+ */
+export function varstaSkymning(r: Ruta, z: number, satta: readonly Placerad[], sida?: { x: number; h: number }): number {
+  let egen = 0;
+  let varst = 0;
+  for (const o of satta) {
+    const samma = !!sida && sammaDjup({ z, ...sida }, o);
+    if (framfor(o.z, { z }) || samma) egen += tacker(o.r, r);
+    if (framfor(z, o) || samma) varst = Math.max(varst, o.tackt + tacker(r, o.r));
+  }
+  return Math.max(varst, egen);
+}
+
+/** Lägger in en ny sak och räknar upp skymningen på dem den står framför. */
+export function lagg(satta: Placerad[], ny: Omit<Placerad, "tackt">): Placerad {
+  let egen = 0;
+  for (const o of satta) {
+    const samma = sammaDjup(ny, o);
+    if (framfor(o.z, ny) || samma) egen += tacker(o.r, ny.r);
+    if (framfor(ny.z, o) || samma) o.tackt += tacker(ny.r, o.r);
+  }
