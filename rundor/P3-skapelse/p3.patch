+      a.fran.mal.copy(c.target);
+      const mal = a.fran.mal.clone().lerp(a.punkt, F.mot);
+      const pos = mal.clone().add(a.fran.pos.clone().sub(a.fran.mal).multiplyScalar(1 - F.narmare));
