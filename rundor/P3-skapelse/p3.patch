+  for (const [kropp, rr] of Object.entries(MODELLER)) for (const n of Object.keys(rr)) if (!DELNAMN.includes(n as DelNamn)) fel.push(`modeller.${kropp}: okänd del ${n}`);
+  return fel;
+}
