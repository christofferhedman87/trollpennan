+  for (const lista of [["blackfisk", "sal", "anka"], ["blackfisk", "sal", "anka", "fisk", "delfin"], ["sal", "anka", "blackfisk", "haj", "narval", "fisk"]]) {
+    const { rutor, andel } = platsRutor(lista, sjon);
+    for (const q of rutor) {
+      if (!q.sim) continue;
+      assert.ok(iVatten(sjon, ...tillPlats(q.x, q.z)), `${q.d.kropp} i vattnet`);
+      assert.ok(q.r.x0 >= -1 && q.r.x1 <= 376, `${lista}: ${q.d.kropp} utanför bilden (x ${q.x.toFixed(2)}, z ${q.z.toFixed(2)})`);
+      assert.ok((andel[q.d.uid] ?? 0) >= 1 - (BAK_ZON.max_skymd ?? 0) - 1e-6, `${lista}: ${q.d.kropp} syns ${(andel[q.d.uid]! * 100).toFixed(0)} %`);
+    }
+  }
