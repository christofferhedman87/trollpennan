+  for (let i = 0; i < hus.length; i += 4) lag.push([`hus${i}`, hus.slice(i, i + 4)]);
+  const fel: string[] = [];
+  let ryms = 0;
+  for (const [namn, kroppar] of lag) {
+    // ryms de inte (bakRymms) somnar den äldsta stora saken när den nya läggs till (minne.ts); provas nedan
+    if (!bakRymms(kroppar.map((k, i) => bygg(`${namn}-${i}`, k)) as never)) continue;
+    ryms++;
+    const { andel } = synligaStora(kroppar, namn);
+    for (const [k, a] of Object.entries(andel)) if (a < 1 - T - 1e-9) fel.push(`${namn}: ${k} syns ${Math.round(a * 100)} %`);
+  }
+  assert.deepEqual(fel, []);
+  assert.ok(ryms >= lag.length * 0.6, `bara ${ryms} av ${lag.length} lag ryms`);
+  for (const n of ["doodle", "doodle-omvand"]) assert.ok(bakRymms(lag.find((l) => l[0] === n)![1].map((k, i) => bygg(`${n}-${i}`, k)) as never), `${n} ryms`);
+  // slottet syns tydligt högre än sjukhuset (överkanten högre på skärmen och minst 20 % högre ruta)
+  const { saker } = synligaStora(["slott", "sjukhus", "cirkus", "vaxthus", "ko"], "hojd");
+  const [s, h] = [saker.find((q) => q.id === "slott")!, saker.find((q) => q.id === "sjukhus")!];
+  assert.ok(s.r.y1 - s.r.y0 >= 1.2 * (h.r.y1 - h.r.y0), `slott ${Math.round(s.r.y1 - s.r.y0)} px, sjukhus ${Math.round(h.r.y1 - h.r.y0)} px`);
+  assert.ok(s.r.y0 < h.r.y0 - 10, `slottets överkant ${Math.round(s.r.y0)}, sjukhusets ${Math.round(h.r.y0)}`);
+});
