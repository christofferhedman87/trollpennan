+      const d = (alla as { uid: string; kropp: string }[]).find((x) => x.uid === uid)!;
+      if (flyger(d.kropp, []) || simmar(d.kropp, [])) continue;
+      assert.ok(!skymmerNy(q[0], q[2], halvBredd(d.kropp), [p[0], p[2]], halvBredd(nyK)), `${n}: ${d.kropp} står framför den nya (${q[0]}, ${q[2]})`);
+      // på skärmen: ingen som står närmare kameran täcker den nya mer än 15 %
+      if (q[2] > p[2]) {
+        const t = tacker(skarmRuta(q[0], 0, q[2], halvBredd(d.kropp), malhojd(d.kropp)), nyR);
+        assert.ok(t <= 0.15, `${n}: ${d.kropp} täcker den nya ${nyK} ${(t * 100).toFixed(0)} %`);
