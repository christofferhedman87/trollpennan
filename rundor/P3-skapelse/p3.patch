+      const minsta = Math.min(q.r.x1 - q.r.x0, q.r.y1 - q.r.y0);
+      assert.ok(minsta >= (SYN?.min_px ?? 0) - 1, `${namn}: bara ${minsta.toFixed(0)} px`);
+      assert.ok(q.k >= (SYN?.min_trang ?? 1) - 1e-9, namn);
