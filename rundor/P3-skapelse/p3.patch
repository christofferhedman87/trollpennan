+// P3 – skapelsen syns rätt: kläderna sitter på kroppen (data/plagg.json), tolkningen ändrar aldrig barnets ord i tysthet,
+// minsta synliga storlek, saker bredvid inte i dammen. Placeringen (den nya framme, ingen skyms) provas i p3a.test.ts.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import fraser from "../../data/test-fraser.json" with { type: "json" };
+import { tolkaMedReserv } from "../tolk/reserv.ts";
+import { arSparrat } from "../tolk/sparr.ts";
+import entJson from "../../data/entiteter.json" with { type: "json" };
+import { ENTITETER, halvBredd, malhojd, skalaFor, SYN, synSkala } from "./entiteter.ts";
+import { sakLage } from "./landning.ts";
+import { kontrolleraPlagg, kroppsdelar, PLAGG, plaggLage, plaggRegel } from "./plagg/data.ts";
+import { platsMed, START_PLATS } from "./platser.ts";
+import { torrKropp } from "./platsYta.ts";
+import { skarmRuta } from "./skarm.ts";
+
+const KLADER = Object.keys(ENTITETER).filter((k) => ENTITETER[k]!.typ === "tillbehor");
+
+
+/** En låda (x0..x1, y0..y1, z0..z1) som punkter. */
+function lada(ut: number[], [x0, y0, z0]: number[], [x1, y1, z1]: number[], n = 6) {
+  for (let i = 0; i <= n; i++) for (let j = 0; j <= n; j++) for (let k = 0; k <= n; k++) ut.push(x0! + ((x1! - x0!) * i) / n, y0! + ((y1! - y0!) * j) / n, z0! + ((z1! - z0!) * k) / n);
+}
+// Tre former: en stående kanin (kropp + huvud ovanpå), en fyrbent häst (huvudet fram och högt), en liggande fisk (lång i z).
+const FORMER: Record<string, number[]> = {};
+{
+  const k: number[] = [];
+  lada(k, [-0.3, 0, -0.25], [0.3, 0.6, 0.25]);
+  lada(k, [-0.22, 0.6, -0.15], [0.22, 1.0, 0.25]);
+  FORMER.kanin = k;
+  const h: number[] = [];
+  lada(h, [-0.25, 0.7, -0.6], [0.25, 1.1, 0.5]); // bål
+  for (const [x, z] of [[-0.18, -0.5], [0.18, -0.5], [-0.18, 0.4], [0.18, 0.4]]) lada(h, [x! - 0.06, 0, z! - 0.06], [x! + 0.06, 0.7, z! + 0.06], 3);
+  lada(h, [-0.12, 1.1, 0.35], [0.12, 1.5, 0.65]); // hals och huvud fram
+  FORMER.hast = h;
+  const f: number[] = [];
+  lada(f, [-0.15, 0, -0.6], [0.15, 0.45, 0.6]);
+  FORMER.fisk = f;
+}
+
+test("P3: alla 38 kläd-entiteter har en rad i data/plagg.json och datan är giltig", () => {
+  assert.equal(KLADER.length, 38);
+  assert.deepEqual(kontrolleraPlagg(KLADER), []);
+  for (const id of KLADER) assert.ok(PLAGG[id], id);
+});
+
+test("P3: kroppsdelarna härleds ur formen – plagget sitter på rätt del på kanin, häst och fisk (alla 38)", () => {
+  for (const [namn, pts] of Object.entries(FORMER)) {
+    const k = kroppsdelar(pts)!;
+    const H = k.ruta.max[1] - k.ruta.min[1];
+    assert.ok(k.huvud.topp > k.ruta.min[1] + 0.9 * H, `${namn}: huvudets topp`);
+    if (namn === "hast") assert.ok(k.huvud.z > 0.2, "hästens huvud sitter fram");
+    for (const id of KLADER) {
+      const l = plaggLage(id, k, [0.5, 0.4, 0.5])!;
+      const del = plaggRegel(id)!.del;
+      const [x, y, z] = l.pos;
+      const h = 0.4 * l.skala;
+      // på kroppen: mitten inom kroppens ruta (med en halv plaggbredd marginal), inte bredvid på marken
+      const m = 0.25 * l.skala + 0.05;
+      assert.ok(x >= k.ruta.min[0] - m && x <= k.ruta.max[0] + m && z >= k.ruta.min[2] - m && z <= k.ruta.max[2] + m, `${namn}/${id}: utanför kroppen (${x.toFixed(2)}, ${z.toFixed(2)})`);
+      assert.ok(l.skala > 0 && h <= 0.75 * H + 1e-9, `${namn}/${id}: storlek ${h.toFixed(2)} av ${H.toFixed(2)}`);
+      if (del === "huvud") assert.ok(y + h / 2 > k.ruta.min[1] + 0.75 * H, `${namn}/${id}: inte på huvudet`);
+      if (del === "fotter") assert.ok(y <= k.ruta.min[1] + 0.01, `${namn}/${id}: inte vid fötterna`);
+      if (del === "kropp" || del === "hoft") assert.ok(y > k.ruta.min[1] && y + h < k.ruta.max[1] + 1e-9, `${namn}/${id}: inte på bålen`);
+    }
+  }
+});
+
+test("P3: 'en kanin med mössa' (Bengtssons första uppdrag) – mössan är ett plagg på huvudet, ingen sak på marken", () => {
+  const u = tolkaMedReserv("en kanin med mössa");
+  assert.equal(u.typ, "skapad");
+  if (u.typ !== "skapad") return;
+  const ids = u.varelse.tillbehor.map((t) => t.id);
+  assert.ok(ids.includes("alvmossa"), JSON.stringify(ids));
+  assert.equal(plaggRegel("alvmossa")?.del, "huvud");
+});
+
+
+test("P3 (Doodle r83a): minsta synliga storlek – varje djur på varje djup är minst syn.min_px (inom max_forstoring)", () => {
+  const S = SYN!;
+  assert.ok(S.min_px > 0 && S.max_forstoring >= 1);
+  let n = 0;
+  for (const [k, e] of Object.entries(ENTITETER)) {
+    if (e.typ !== "djur") continue;
+    for (const z of [-6, -4, -2, 0, 2]) {
+      const f = synSkala(k, 1, z);
+      const r = skarmRuta(0, 0, z, halvBredd(k) * f, malhojd(k) * f);
+      const minsta = Math.min(r.x1 - r.x0, r.y1 - r.y0);
+      assert.ok(minsta >= S.min_px - 0.5 || f >= S.max_forstoring - 1e-9, `${k} på z ${z}: ${minsta.toFixed(0)} px`);
+      n++;
+    }
+  }
+  assert.ok(n > 500);
+  const narval = skarmRuta(0, 0, -4, halvBredd("narval") * synSkala("narval", 1, -4), malhojd("narval") * synSkala("narval", 1, -4));
+  assert.ok(narval.y1 - narval.y0 >= S.min_px - 0.5, "narvalen");
+});
+
+test("P3: en sak bredvid ett djur vid dammen står på torr mark", () => {
+  const ang = platsMed(START_PLATS)!;
+  const torr = (wx: number, wz: number) => torrKropp(ang, wx, wz, 0.4);
+  let provade = 0;
+  for (let x = -1.5; x <= 1.5; x += 0.25)
+    for (let z = -1; z <= 1.5; z += 0.25) {
+      if (!torrKropp(ang, x, z, 0.5)) continue;
+      provade++;
+      const [ox, oz] = sakLage(x, z, [0.8, 0.2], torr);
+      const ok = [[0.8, 0.2], [-0.8, 0.2], [0.32, 0.75], [-0.32, 0.75], [0.8, 0.8], [-0.8, 0.8]].some(([a, b]) => torr(x + a!, z + b!));
+      if (ok) assert.ok(torr(x + ox, z + oz), `hinken i dammen vid (${x}, ${z})`);
+    }
+  assert.ok(provade > 10);
+});
+
+test("P3: tolkningen ändrar aldrig barnets ord i tysthet (data/test-fraser.json p3_tolkning)", () => {
+  const rader = (fraser as unknown as { p3_tolkning: { fraser: { fras: string; aldrig?: string[]; kropp?: string; agg?: string; formel?: string; fraga?: string; sparr?: boolean }[] } }).p3_tolkning.fraser;
+  assert.ok(rader.length >= 10);
+  for (const r of rader) {
+    const u = tolkaMedReserv(r.fras);
+    const namn = JSON.stringify(r.fras);
+    if (r.sparr) {
+      assert.equal(u.typ, "sparr", namn);
+      continue;
+    }
+    if (r.kropp) assert.equal(u.typ, "skapad", `${namn}: ${u.typ}`);
+    if (r.fraga) {
+      assert.equal(u.typ, "forslag", namn);
+      if (u.typ === "forslag") assert.deepEqual(u.forslag.map((f) => f.id), [r.fraga], namn);
+    }
+    if (u.typ === "skapad") {
+      const ord = u.varelse.formel.split(/\s+/);
+      for (const a of r.aldrig ?? []) assert.ok(!ord.includes(a), `${namn} → "${u.varelse.formel}" innehåller ${a}`);
+      if (r.formel) assert.equal(u.varelse.formel, r.formel, namn);
+      if (r.kropp) assert.equal(u.varelse.kropp, r.kropp, namn);
+      if (r.agg) {
+        assert.ok(u.okanda.includes(r.agg), `${namn}: ${r.agg} inte sparat som okänt`);
+        assert.ok(u.meddelanden.some((m) => m.includes(r.agg!)), `${namn}: barnet får inte veta om ${r.agg}`);
+      }
+      // generellt: varje ord barnet skrev finns i formeln, är ett känt funktionsord eller sägs till om (okända)
+      for (const t of r.fras.toLocaleLowerCase("sv").split(/\s+/)) {
+        if (["en", "ett"].includes(t)) continue;
+        assert.ok(u.okanda.includes(t) || u.varelse.formel.includes(t) || u.funna.length > 0, `${namn}: ordet ${t} försvann tyst`);
+      }
+    } else if (!r.fraga) assert.ok(u.typ === "forslag" || u.typ === "behover_djur", `${namn}: ${u.typ}`);
+    if (u.typ === "forslag") for (const a of r.aldrig ?? []) assert.ok(!u.forslag.some((f) => f.id === a) || r.fraga === a || u.token !== r.fras, namn);
+  }
+});
+
+test("P3 (Doodle 15:35): småsaker har rimlig inbördes storlek – pucken är mindre än kaffekoppen, ordningen följer målhöjden", () => {
+  // modellernas egna mått (GLB-bbox: höjd, bredd, djup), uppmätta 2026-10-20
+  const matt: Record<string, [number, number, number]> = { puck: [0.08, 0.24, 0.24], kaffekopp: [0.25, 0.32, 0.32], kopp: [0.2, 0.23, 0.29], tallrik: [0.1, 0.95, 0.95] };
+  const storst = (k: string) => Math.max(...matt[k]!) * skalaFor(k, ...matt[k]!);
+  assert.ok(storst("puck") < 0.92 * storst("kaffekopp"), `puck ${storst("puck").toFixed(2)}, kaffekopp ${storst("kaffekopp").toFixed(2)}`);
+  assert.ok(storst("kaffekopp") <= storst("kopp") + 1e-9 && storst("kopp") <= storst("tallrik") + 1e-9, "kaffekopp ≤ kopp ≤ tallrik (målhöjd 0,4 / 0,5 / 0,5)");
+  // ingen småsak försvinner: största måttet minst storlek × (1 − lutning) + lutning × målhöjd
+  assert.ok(storst("puck") >= 0.3, `puck ${storst("puck")}`);
+});
+
+test("P3: inget ord som har en modell spärras (delordsmatchning mot korta stammar)", () => {
+  const ent = (entJson as unknown as { entiteter: Record<string, { ord?: string[] }> }).entiteter;
+  const ord = [...new Set(Object.values(ent).flatMap((e) => e.ord ?? []))];
+  const sparrade = ord.filter((w) => arSparrat(`en ${w}`) || arSparrat(`en röd ${w}`));
+  assert.deepEqual(sparrade, []);
+  for (const w of ["porr", "en porrkanin", "pooorr"]) assert.ok(arSparrat(w), w);
+});
+
