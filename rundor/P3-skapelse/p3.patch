+// Doodle 15:35: byggnader och stora saker skymmer varandra (växthuset slottets nederdel, glaslådan slottets högra del,
+// cirkustältet sjukhusets nederkant). En regel: varje sak syns till minst 1 − max_skymd av sin skärmruta.
+const BYGG_ANG = platsMed(START_PLATS)!;
+const bygg = (uid: string, kropp: string) => ({ uid, kropp, skala: 1, formagor: [], tillbehor: [], farg: null, formel: kropp, skapad: 0 });
+function synligaStora(kroppar: string[], namn: string) {
+  const alla = kroppar.map((k, i) => bygg(`${namn}-${i}`, k));
+  const stora = alla.filter((d) => storlekKlass(d.kropp)?.zon === "bak");
+  const saker = stora.map((d) => {
+    const [x, , z] = djurPlats(d as never, alla as never, BYGG_ANG);
+    const k = bakSkala(d.uid);
+    return { id: d.kropp, z, x, k, r: sakRuta(x, z, halvBredd(d.kropp) * k, malhojd(d.kropp) * takSkala(d.kropp, 1) * k) };
+  });
+  // ängens fasta saker (spökhuset) skymmer också
+  for (const f of BAK_ZON.fasta ?? []) saker.push({ id: f.namn, z: f.z, x: f.x, k: 1, r: sakRuta(f.x, f.z, f.halv, f.hojd, f.djup) });
+  return { saker, andel: synligAndel(saker) };
+}
+test("P3 (Doodle 15:35): ingen byggnad eller stor sak skyms mer än max_skymd – Doodles ängar och alla byggnader i lag", () => {
+  // placeringen siktar på max_skymd; provet tål 0,1 till (modellens verkliga form mot den räknade rutan)
+  const T = BAK_ZON.max_skymd! + 0.1;
