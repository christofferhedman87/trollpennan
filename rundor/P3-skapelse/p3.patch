index 0000000..aa03b49
--- /dev/null
+++ b/src/spel/plagg/data.ts
@@ -0,0 +1,152 @@
+// P3: kläder på skapelsen. Rena funktioner över data/plagg.json (ingen three-import, testas i Node).
+// Kroppsdelarna (huvud, hals, kropp, höft, fötter, hand) härleds generellt ur skapelsens egna punkter i höjdband,
+// så att mössan hamnar på huvudet på en kanin, en häst, en fisk eller en bil utan en rad per modell.
+import plaggJson from "../../../data/plagg.json" with { type: "json" };
+
+export type DelNamn = "huvud" | "hals" | "kropp" | "hoft" | "fotter" | "hand";
+export const DELNAMN: readonly DelNamn[] = ["huvud", "hals", "kropp", "hoft", "fotter", "hand"];
+export type DelRegel = { band: [number, number]; fyll: number; maxH: number; sjunk?: number; fram?: number };
+export type PlaggRad = { del: DelNamn; fyll?: number; maxH?: number; par?: boolean };
+/** Rättning per kropp: andelar (0–1) av kroppens ruta för en dels mitt, och/eller dess bredd som andel av rutans bredd. */
+export type DelRatt = { f?: [number, number, number]; bredd?: number };
+
+type PlaggData = { delar: Record<DelNamn, DelRegel>; plagg: Record<string, PlaggRad>; modeller: Record<string, Partial<Record<DelNamn, DelRatt>>> };
+const D = plaggJson as unknown as PlaggData;
+export const DELAR = D.delar;
+export const PLAGG = D.plagg;
+export const MODELLER = D.modeller;
+
+export function arPlagg(id: string): boolean {
+  return !!PLAGG[id];
+}
+
+/** Regeln för plagget: delens regel med plaggets egna fyll/maxH ovanpå. */
+export function plaggRegel(id: string): (DelRegel & { del: DelNamn; par: boolean }) | null {
+  const p = PLAGG[id];
+  if (!p) return null;
+  const r = DELAR[p.del];
+  return { ...r, fyll: p.fyll ?? r.fyll, maxH: p.maxH ?? r.maxH, del: p.del, par: !!p.par };
+}
+
+export type Punkt = [number, number, number];
+/** En kroppsdel: mitt (x, y, z), bredd (x), djup (z), framkant (z), topp och botten (y). */
+export type Kroppsdel = { x: number; y: number; z: number; bredd: number; djup: number; fram: number; topp: number; botten: number };
+export type Kroppsdelar = Record<DelNamn, Kroppsdel> & { ruta: { min: Punkt; max: Punkt } };
+
+function kvantil(s: number[], q: number): number {
+  if (!s.length) return 0;
+  const i = Math.min(s.length - 1, Math.max(0, Math.round(q * (s.length - 1))));
+  return s[i]!;
+}
+
+/**
+ * Kroppsdelarna ur skapelsens punkter (lokala koordinater, +y upp, +z mot kameran). Varje del är punkterna i delens
+ * höjdband (data/plagg.json `delar.*.band`, andelar av höjden): mitten är bandets median, bredden 10–90 %-spannet i x.
+ * Huvudets topp är bandets översta punkt, handen kroppsbandets högra kant. `ratt` (data `modeller`) ersätter en dels mitt/bredd.
+ * `xyz` = platta punkter [x0, y0, z0, x1, …].
+ */
+export function kroppsdelar(xyz: ArrayLike<number>, ratt: Partial<Record<DelNamn, DelRatt>> = {}): Kroppsdelar | null {
+  const n = Math.floor(xyz.length / 3);
+  if (n < 4) return null;
+  const min: Punkt = [Infinity, Infinity, Infinity];
+  const max: Punkt = [-Infinity, -Infinity, -Infinity];
+  for (let i = 0; i < n; i++)
+    for (let k = 0; k < 3; k++) {
+      const v = xyz[i * 3 + k]!;
+      if (v < min[k]!) min[k] = v;
+      if (v > max[k]!) max[k] = v;
+    }
+  const H = Math.max(1e-4, max[1] - min[1]);
+  const W = Math.max(1e-4, max[0] - min[0]);
+  const ut = { ruta: { min, max } } as Kroppsdelar;
+  for (const namn of DELNAMN) {
+    const [a, b] = DELAR[namn].band;
+    const y0 = min[1] + a * H;
+    const y1 = min[1] + b * H;
+    const xs: number[] = [];
+    const ys: number[] = [];
+    const zs: number[] = [];
+    for (let i = 0; i < n; i++) {
+      const y = xyz[i * 3 + 1]!;
+      if (y < y0 - 1e-6 || y > y1 + 1e-6) continue;
+      xs.push(xyz[i * 3]!);
+      ys.push(y);
+      zs.push(xyz[i * 3 + 2]!);
+    }
+    if (!xs.length) {
+      xs.push((min[0] + max[0]) / 2);
+      ys.push((y0 + y1) / 2);
+      zs.push((min[2] + max[2]) / 2);
+    }
+    xs.sort((p, q) => p - q);
+    ys.sort((p, q) => p - q);
+    zs.sort((p, q) => p - q);
+    const del: Kroppsdel = {
+      x: (kvantil(xs, 0.1) + kvantil(xs, 0.9)) / 2,
+      y: kvantil(ys, 0.5),
+      z: kvantil(zs, 0.5),
+      bredd: Math.max(0.05 * W, kvantil(xs, 0.9) - kvantil(xs, 0.1)),
+      djup: Math.max(0.02, kvantil(zs, 0.9) - kvantil(zs, 0.1)),
+      fram: kvantil(zs, DELAR[namn].fram ?? 0.9),
+      topp: kvantil(ys, 0.99),
+      botten: kvantil(ys, 0.01),
+    };
+    if (namn === "hand") {
+      del.x = kvantil(xs, 0.95);
+      del.y = (y0 + y1) / 2;
+    }
+    const r = ratt[namn];
+    if (r?.f) {
+      del.x = min[0] + r.f[0] * W;
+      del.y = min[1] + r.f[1] * H;
+      del.z = min[2] + r.f[2] * (max[2] - min[2]);
+      del.topp = del.y;
+      del.fram = Math.max(del.fram, del.z);
+    }
+    if (r?.bredd) del.bredd = r.bredd * W;
+    ut[namn] = del;
+  }
+  return ut;
+}
+
+/** Plaggets läge och skala. `box` = plaggets egen storlek [b, h, d] efter vridning, botten i y = 0 och mitten i x/z = 0. */
+export function plaggLage(id: string, k: Kroppsdelar, box: Punkt): { pos: Punkt; skala: number; par: number } | null {
+  const r = plaggRegel(id);
+  if (!r) return null;
+  const H = k.ruta.max[1] - k.ruta.min[1];
+  const d = k[r.del];
+  const [bw, bh, bd] = [Math.max(1e-4, box[0]), Math.max(1e-4, box[1]), Math.max(1e-4, box[2])];
+  const par = r.par ? 2 : 1;
+  // hand: storleken efter kroppens höjd (trollstaven ska synas), annars efter delens bredd
+  let s = r.del === "hand" ? (r.fyll * H) / Math.max(bh, bw) : (d.bredd * r.fyll) / par / bw;
+  s = Math.min(s, (r.maxH * H) / bh);
+  const h = bh * s;
+  let y: number;
+  let z = d.z;
+  if (r.del === "huvud") y = d.topp - (r.sjunk ?? 0) * h;
+  else if (r.del === "fotter") {
+    y = k.ruta.min[1];
+    z = d.fram - (bd * s) / 2;
+  } else if (r.del === "hals") {
+    y = d.y - h / 2;
+    z = d.fram;
+  } else y = d.y - h / 2;
+  return { pos: [d.x, y, z], skala: s, par };
+}
+
+/** Granskar datan mot entiteterna. Tom lista = ok. */
+export function kontrolleraPlagg(kladIds: string[]): string[] {
+  const fel: string[] = [];
+  for (const id of kladIds) if (!PLAGG[id]) fel.push(`${id}: kläd-entitet utan rad i data/plagg.json`);
+  for (const [id, p] of Object.entries(PLAGG)) {
+    if (!DELNAMN.includes(p.del)) fel.push(`${id}: okänd del ${String(p.del)}`);
+    if (p.fyll !== undefined && !(p.fyll > 0)) fel.push(`${id}: ogiltig fyll`);
+    if (p.maxH !== undefined && !(p.maxH > 0)) fel.push(`${id}: ogiltig maxH`);
+  }
+  for (const n of DELNAMN) {
+    const r = DELAR[n];
+    if (!r || r.band[0] < 0 || r.band[1] > 1 || r.band[0] >= r.band[1]) fel.push(`delar.${n}: ogiltigt band`);
+  }
+  for (const [kropp, rr] of Object.entries(MODELLER)) for (const n of Object.keys(rr)) if (!DELNAMN.includes(n as DelNamn)) fel.push(`modeller.${kropp}: okänd del ${n}`);
+  return fel;
+}
