+export function placeraMedMinne(alla: readonly Sparad[], plats?: Plats): Map<string, Lage> {
+  const nyckel = `${plats?.id ?? START_PLATS}|${alla.map((d) => `${d.uid}:${d.kropp}:${d.skala}:${d.skapad}:${d.formagor.includes("vingar") ? 1 : 0}`).join(",")}`;
