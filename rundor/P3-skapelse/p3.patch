+test("P3: kroppsdelarna härleds ur formen – plagget sitter på rätt del på kanin, häst och fisk (alla 38)", () => {
+  for (const [namn, pts] of Object.entries(FORMER)) {
+    const k = kroppsdelar(pts)!;
+    const H = k.ruta.max[1] - k.ruta.min[1];
+    assert.ok(k.huvud.topp > k.ruta.min[1] + 0.9 * H, `${namn}: huvudets topp`);
+    if (namn === "hast") assert.ok(k.huvud.z > 0.2, "hästens huvud sitter fram");
+    for (const id of KLADER) {
+      const l = plaggLage(id, k, [0.5, 0.4, 0.5])!;
+      const del = plaggRegel(id)!.del;
+      const [x, y, z] = l.pos;
+      const h = 0.4 * l.skala;
+      // på kroppen: mitten inom kroppens ruta (med en halv plaggbredd marginal), inte bredvid på marken
+      const m = 0.25 * l.skala + 0.05;
+      assert.ok(x >= k.ruta.min[0] - m && x <= k.ruta.max[0] + m && z >= k.ruta.min[2] - m && z <= k.ruta.max[2] + m, `${namn}/${id}: utanför kroppen (${x.toFixed(2)}, ${z.toFixed(2)})`);
+      assert.ok(l.skala > 0 && h <= 0.75 * H + 1e-9, `${namn}/${id}: storlek ${h.toFixed(2)} av ${H.toFixed(2)}`);
+      if (del === "huvud") assert.ok(y + h / 2 > k.ruta.min[1] + 0.75 * H, `${namn}/${id}: inte på huvudet`);
+      if (del === "fotter") assert.ok(y <= k.ruta.min[1] + 0.01, `${namn}/${id}: inte vid fötterna`);
+      if (del === "kropp" || del === "hoft") assert.ok(y > k.ruta.min[1] && y + h < k.ruta.max[1] + 1e-9, `${namn}/${id}: inte på bålen`);
+    }
+  }
+});
