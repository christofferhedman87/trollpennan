+  for (const id of kladIds) if (!PLAGG[id]) fel.push(`${id}: kläd-entitet utan rad i data/plagg.json`);
+  for (const [id, p] of Object.entries(PLAGG)) {
+    if (!DELNAMN.includes(p.del)) fel.push(`${id}: okänd del ${String(p.del)}`);
+    if (p.fyll !== undefined && !(p.fyll > 0)) fel.push(`${id}: ogiltig fyll`);
+    if (p.maxH !== undefined && !(p.maxH > 0)) fel.push(`${id}: ogiltig maxH`);
+  }
+  for (const n of DELNAMN) {
+    const r = DELAR[n];
+    if (!r || r.band[0] < 0 || r.band[1] > 1 || r.band[0] >= r.band[1]) fel.push(`delar.${n}: ogiltigt band`);
