+    const dt = t - a.t0;
+    let u: number;
+    let fas: "in" | "kvar" | "ut" | "klar";
+    if (dt < F.in_ms) [u, fas] = [mjuk(dt / F.in_ms), "in"];
+    else if (dt < F.in_ms + F.stanna_ms) [u, fas] = [1, "kvar"];
+    else if (dt < F.in_ms + F.stanna_ms + F.ut_ms) [u, fas] = [1 - mjuk((dt - F.in_ms - F.stanna_ms) / F.ut_ms), "ut"];
