+  const mx = mc.getContext("2d");
+  if (!mx) return null;
+  const md = mx.createImageData(w, h);
+  let antal = 0;
+  const malHsl = mal ? hexTillHsl(mal) : null;
+  const alb = mal ? malAlbedo(mal, tint) : null;
+  for (let i = 0; i < w * h; i++) {
+    const v = mask[i] ? 255 : 0;
+    md.data[i * 4] = md.data[i * 4 + 1] = md.data[i * 4 + 2] = v;
+    md.data[i * 4 + 3] = 255;
+    if (!mask[i]) continue;
+    antal++;
+    if (!malHsl || !alb) continue;
+    const o = i * 4;
+    const r = d[o] ?? 0, g = d[o + 1] ?? 0, b = d[o + 2] ?? 0;
+    if (k.neutral) {
+      const gra = tillLinjar(graNiva(r, g, b, k.bodyL));
+      d[o] = tillSrgb(gra * alb[0]);
+      d[o + 1] = tillSrgb(gra * alb[1]);
+      d[o + 2] = tillSrgb(gra * alb[2]);
+    } else {
+      const [nr, ng, nb] = byttPixel(rgbTillHsl(r, g, b), { from: k.hsl[0], range: 22, bodyL: k.bodyL }, malHsl, tint);
+      d[o] = nr;
+      d[o + 1] = ng;
+      d[o + 2] = nb;
+    }
+  }
+  mx.putImageData(md, 0, 0);
+  let map: THREE.Texture | null = null;
+  if (mal) {
+    p.x.putImageData(p.bild, 0, 0);
+    map = somKalla(new THREE.CanvasTexture(p.c), tex, true);
+  }
+  const ut = { map, mask: somKalla(new THREE.CanvasTexture(mc), tex, false), andel: antal / (w * h) };
+  TEX.set(nyckel, ut);
+  return ut;
+}
+
+/** Hörnen som en grupp i nätet använder (materialindex `mi`), eller alla. */
+function hornFor(mesh: THREE.Mesh, mi: number): number[] {
+  const geo = mesh.geometry;
+  const idx = geo.index;
+  const n = idx ? idx.count : geo.attributes.position?.count ?? 0;
+  const grupper = geo.groups.length > 0 ? geo.groups.filter((g) => (g.materialIndex ?? 0) === mi) : [{ start: 0, count: n }];
+  const s = new Set<number>();
+  for (const g of grupper) for (let i = g.start; i < Math.min(n, g.start + g.count); i++) s.add(idx ? idx.getX(i) : i);
+  return [...s];
+}
+
+/** Egen kopia av geometrin (delas annars med alla kloner av modellen via useGLTF). */
+function egenGeometri(mesh: THREE.Mesh): THREE.BufferGeometry {
+  if (!mesh.userData.r83a2Geo) {
+    mesh.geometry = mesh.geometry.clone();
+    mesh.userData.r83a2Geo = true;
+  }
+  return mesh.geometry;
+}
+
+/** Har nätet hörnfärger som inte bara är vita? (Vita hörnfärger ändrar ingenting och lämnas.) */
+export function harHornfarg(mesh: THREE.Mesh, m: THREE.Material): boolean {
+  const c = mesh.geometry?.attributes?.color;
+  if (!c || !(m as THREE.MeshStandardMaterial).vertexColors) return false;
+  for (let i = 0; i < c.count; i++) if (c.getX(i) < 0.98 || c.getY(i) < 0.98 || c.getZ(i) < 0.98) return true;
+  return false;
+}
+
+/** Hörnfärgerna i ett material med färgord: kroppens hörn får färgen (utan textur: målets nyans med hörnets ljushet relativt
+ *  kroppen; med textur: gråskala relativt kroppen, texturen bär färgen), övriga hörn behåller sin färg. Materialets färg bakas in
+ *  i hörnen och blir vit. Ger kroppsvikten per hörn (1/0) för mönstret, eller null. */
+export function fargaHorn(mesh: THREE.Mesh, mi: number, matFarg: THREE.Color, mal: string | null, harKarta: boolean, tint: Tint): Map<number, number> | null {
+  const c0 = mesh.geometry.attributes.color;
+  if (!c0) return null;
+  const horn = hornFor(mesh, mi);
+  const lin: number[] = [];
+  const srgb: number[] = [];
+  for (const i of horn) {
+    const r = c0.getX(i) * matFarg.r, g = c0.getY(i) * matFarg.g, b = c0.getZ(i) * matFarg.b;
+    lin.push(r, g, b);
+    srgb.push(tillSrgb(r), tillSrgb(g), tillSrgb(b));
+  }
+  const hk = hornKropp(srgb);
+  if (!hk) return null;
+  const vikt = new Map<number, number>();
+  horn.forEach((i, j) => vikt.set(i, hk.kropp[j] ?? 0));
+  if (!mal) return vikt;
+  const geo = egenGeometri(mesh);
+  const gammal = geo.attributes.color!;
+  const ny = new Float32Array(gammal.count * 3);
+  for (let i = 0; i < gammal.count; i++) {
+    ny[i * 3] = gammal.getX(i);
+    ny[i * 3 + 1] = gammal.getY(i);
+    ny[i * 3 + 2] = gammal.getZ(i);
+  }
+  const kroppL = hk.karna.hsl[2];
+  const [kr, kg, kb] = hslTillRgb(...hk.karna.hsl);
+  const kLum = Math.max(1e-4, 0.2126 * tillLinjar(kr) + 0.7152 * tillLinjar(kg) + 0.0722 * tillLinjar(kb));
+  const malHsl = hexTillHsl(mal);
+  horn.forEach((i, j) => {
+    const r = lin[j * 3]!, g = lin[j * 3 + 1]!, b = lin[j * 3 + 2]!;
+    let ut: [number, number, number] = [r, g, b];
+    if (hk.kropp[j]) {
+      if (harKarta) {
+        const v = Math.min(1, (0.2126 * r + 0.7152 * g + 0.0722 * b) / kLum);
+        ut = [v, v, v];
+      } else {
+        const [nr, ng, nb] = byttPixel(rgbTillHsl(srgb[j * 3]!, srgb[j * 3 + 1]!, srgb[j * 3 + 2]!), { from: 0, range: 22, bodyL: kroppL }, malHsl, tint);
+        ut = [tillLinjar(nr), tillLinjar(ng), tillLinjar(nb)];
+      }
+    }
+    ny[i * 3] = ut[0];
+    ny[i * 3 + 1] = ut[1];
+    ny[i * 3 + 2] = ut[2];
+  });
+  geo.setAttribute("color", new THREE.BufferAttribute(ny, 3));
+  return vikt;
+}
+
+/** Mönstrets koordinater: `aMonster` = (x, y, z) i modellens rotram (vilopose, normerat med största måttet) och w = kroppsvikt.
+ *  Ger skalan för höjden (band) och den längsta vågräta axeln (ränder). */
+export function monsterKoordinater(rot: THREE.Object3D, nat: THREE.Mesh[], vikter: Map<THREE.Mesh, Map<number, number>>): { skalaY: number; axel: [number, number, number] } {
+  rot.updateMatrixWorld(true);
+  const inv = rot.matrixWorld.clone().invert();
+  const v = new THREE.Vector3();
+  const box = new THREE.Box3();
+  const pos = new Map<THREE.Mesh, Float32Array>();
+  for (const m of nat) {
+    const n = m.geometry.attributes.position?.count ?? 0;
+    const a = new Float32Array(n * 3);
+    const mw = new THREE.Matrix4().multiplyMatrices(inv, m.matrixWorld);
+    for (let i = 0; i < n; i++) {
+      m.getVertexPosition(i, v).applyMatrix4(mw);
+      a[i * 3] = v.x;
+      a[i * 3 + 1] = v.y;
+      a[i * 3 + 2] = v.z;
+      box.expandByPoint(v);
+    }
+    pos.set(m, a);
+  }
+  const st = box.getSize(new THREE.Vector3());
+  const max = Math.max(1e-6, st.x, st.y, st.z);
+  for (const m of nat) {
+    const a = pos.get(m)!;
+    const n = a.length / 3;
+    const ut = new Float32Array(n * 4);
+    const vk = vikter.get(m);
+    for (let i = 0; i < n; i++) {
+      ut[i * 4] = (a[i * 3]! - box.min.x) / max;
+      ut[i * 4 + 1] = (a[i * 3 + 1]! - box.min.y) / max;
+      ut[i * 4 + 2] = (a[i * 3 + 2]! - box.min.z) / max;
+      ut[i * 4 + 3] = vk ? (vk.get(i) ?? 0) : 1;
+    }
+    egenGeometri(m).setAttribute("aMonster", new THREE.BufferAttribute(ut, 4));
+  }
+  return { skalaY: max / Math.max(1e-6, st.y), axel: st.x >= st.z ? [1, 0, 0] : [0, 0, 1] };
+}
+
+const TYP = { band: 0, rander: 1, prickar: 2 } as const;
+
+/** Mönstret på ett kroppsmaterial (MeshStandardMaterial-klon). `ref` = kroppens luminans (linjär), så att texturens skuggning
+ *  följer med; `farger` linjära albedon (förkompenserade för ljuset); `mask` = kroppsmasken om materialet har textur. */
+export function monsterPa(m: THREE.MeshStandardMaterial, km: KroppsMonster, o: { farger: [number, number, number][]; ref: number; skalaY: number; axel: [number, number, number]; mask: THREE.Texture | null }) {
+  const f = o.farger.slice(0, 6);
+  while (f.length < 6) f.push(f[f.length - 1] ?? [0.2, 0.2, 0.2]);
+  const typ = TYP[km.typ];
+  const harMask = !!(o.mask && m.map);
+  m.defines = { ...(m.defines ?? {}), MONSTER_TYP: typ, ...(harMask ? { MONSTER_MASK: "" } : {}) };
+  m.customProgramCacheKey = () => `r83a2-monster-${typ}-${harMask ? 1 : 0}`;
+  m.userData.monster = km.typ;
+  m.onBeforeCompile = (s) => {
+    s.uniforms.uMFarg = { value: f.map((c) => new THREE.Vector3(...c)) };
+    s.uniforms.uMAntal = { value: km.typ === "band" ? Math.max(1, Math.min(6, km.farger.length || km.antal)) : km.antal };
+    s.uniforms.uMRef = { value: Math.max(1e-3, o.ref) };
+    s.uniforms.uMSkalaY = { value: o.skalaY };
+    s.uniforms.uMAxel = { value: new THREE.Vector3(...o.axel) };
+    s.uniforms.uMMask = { value: harMask ? o.mask : null };
+    s.vertexShader = s.vertexShader
+      .replace("#include <common>", "#include <common>\nattribute vec4 aMonster;\nvarying vec4 vMonster;")
+      .replace("#include <begin_vertex>", "#include <begin_vertex>\nvMonster = aMonster;");
+    s.fragmentShader = s.fragmentShader
+      .replace(
+        "#include <common>",
+        "#include <common>\nvarying vec4 vMonster;\nuniform vec3 uMFarg[6];\nuniform float uMAntal;\nuniform float uMRef;\nuniform float uMSkalaY;\nuniform vec3 uMAxel;\n#ifdef MONSTER_MASK\nuniform sampler2D uMMask;\n#endif",
+      )
+      .replace("#include <color_fragment>", `#include <color_fragment>
+{
+  float kv = vMonster.w;
+#ifdef MONSTER_MASK
+  kv *= texture2D(uMMask, vMapUv).r;
+#endif
+  if (kv > 0.01) {
+    float lum = dot(diffuseColor.rgb, vec3(0.2126, 0.7152, 0.0722));
+    float sk = clamp(lum / uMRef, 0.55, 1.3);
+    vec3 ny = diffuseColor.rgb;
+#if MONSTER_TYP == 0
+    float t = clamp(vMonster.y * uMSkalaY, 0.0, 0.9999);
+    int bi = int(uMAntal) - 1 - int(floor(t * uMAntal));
+    vec3 bc = uMFarg[0];
+    for (int k = 1; k < 6; k++) { if (k == bi) bc = uMFarg[k]; }
+    ny = bc * sk;
+#elif MONSTER_TYP == 1
+    float u = dot(vMonster.xyz, uMAxel) + 0.025 * sin(vMonster.y * 18.0);
+    float fr = fract(u * uMAntal);
+    float rm = smoothstep(0.06, 0.12, fr) * (1.0 - smoothstep(0.44, 0.50, fr));
+    ny = mix(diffuseColor.rgb, uMFarg[0] * sk, rm);
+#else
+    vec3 pp = vMonster.xyz * uMAntal;
+    vec3 ce = floor(pp);
+    vec3 rr = fract(sin(vec3(dot(ce, vec3(127.1, 311.7, 74.7)), dot(ce, vec3(269.5, 183.3, 246.1)), dot(ce, vec3(113.5, 271.9, 124.6)))) * 43758.5453);
+    vec3 fp = fract(pp) - 0.5 - (rr - 0.5) * 0.3;
+    float pm = 1.0 - smoothstep(0.30, 0.35, length(fp));
+    ny = mix(diffuseColor.rgb, uMFarg[0] * sk, pm);
+#endif
+    diffuseColor.rgb = mix(diffuseColor.rgb, ny, kv);
+  }
+}`);
+  };
+  m.needsUpdate = true;
+}
+
+/** Mönstrets färger (linjära albedon): datans/ordets färger förkompenserade för ljuset; utan färger en mörkare ton av
+ *  kroppen (ljusare på en mörk kropp). `kropp` = kroppens färg i sRGB-hex. */
+export function monsterFarger(km: KroppsMonster, kropp: string, tint: Tint): [number, number, number][] {
+  if (km.farger.length) return km.farger.map((h) => malAlbedo(h, tint));
+  const [h, s, l] = hexTillHsl(kropp);
+  const [r, g, b] = hslTillRgb(h, Math.min(1, s * 1.1), l > 0.3 ? l * 0.35 : Math.min(0.9, l + 0.45));
+  return [[tillLinjar(r), tillLinjar(g), tillLinjar(b)]];
+}
diff --git a/src/spel/r8-3a2.test.ts b/src/spel/r8-3a2.test.ts
new file mode 100644
index 0000000..bc93ce1
--- /dev/null
+++ b/src/spel/r8-3a2.test.ts
@@ -0,0 +1,153 @@
+// R8-3a2: kroppens färg följer hela kroppen (gradient i samma färgruta, kedja av material), detaljer i samma textur behålls
+// (betar, ögon, näbb), hörnfärger bakas in, och mönster (regnbåge, ränder, prickar) målas på kroppen ur data.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import attributJson from "../../data/attribut.json" with { type: "json" };
+import { ORD } from "../tolk/data.ts";
+import { tolka } from "../tolk/tolka.ts";
+import { effekterBredvid, effekterFor, kroppsMonsterFor } from "./attribut.ts";
+import { fargning, hornKropp, iKarnan, kroppsMask, kroppsRoller, MASK, valjKarna, type MatInfo } from "./fargning.ts";
+import { hexTillHsl, hslTillRgb, rgbTillHsl } from "./palett.ts";
+
+const mat = (namn: string, hex: string, yta: number): MatInfo => ({ namn, hsl: hexTillHsl(hex), yta });
+const roller = (m: MatInfo[], r?: Record<string, string>) => kroppsRoller(m, r).map((x) => x.roll);
+
+/** En textur med rutor (som Gobkit-atlasen): varje ruta en lodrät gradient mellan två färger. */
+function atlas(rutor: [string, string][], rw = 8, h = 32) {
+  const w = rutor.length * rw;
+  const d = new Uint8ClampedArray(w * h * 4);
+  rutor.forEach(([a, b], r) => {
+    const A = hexTillHsl(a), B = hexTillHsl(b);
+    for (let y = 0; y < h; y++) {
+      const t = y / (h - 1);
+      const dh = ((B[0] - A[0] + 540) % 360) - 180;
+      const [R, G, Bl] = hslTillRgb(A[0] + dh * t, A[1] + (B[1] - A[1]) * t, A[2] + (B[2] - A[2]) * t);
+      for (let x = r * rw; x < (r + 1) * rw; x++) {
+        const o = (y * w + x) * 4;
+        d[o] = R; d[o + 1] = G; d[o + 2] = Bl; d[o + 3] = 255;
+      }
+    }
+  });
+  return { d, w, h, rw };
+}
+/** Användning: stickprov mitt i ruta r, raderna y0..y1 (vikt 1 per texel). */
+const anvand = (w: number, rw: number, delar: [number, number, number][]) => {
+  const i: number[] = [], n: number[] = [];
+  for (const [r, y0, y1] of delar) for (let y = y0; y <= y1; y++) { i.push(y * w + r * rw + Math.floor(rw / 2)); n.push(1); }
+  return { i, n };
+};
+const andelRuta = (mask: Uint8Array, w: number, h: number, rw: number, r: number) => {
+  let n = 0;
+  for (let y = 0; y < h; y++) for (let x = r * rw; x < (r + 1) * rw; x++) n += mask[y * w + x] ?? 0;
+  return n / (rw * h);
+};
+
+test("R8-3a2: ankan – hela färgrutan med ryggens gulgröna och magens gröna gradient är kropp, näbbens orange ruta behålls", () => {
+  // ruta 0: kroppen (61° → 115°, som ankans atlasruta 13,3), ruta 1: näbb/fötter (20°), ruta 2: ögon (mörka)
+  const { d, w, h, rw } = atlas([["#9AA62E", "#2F8C3A"], ["#C2632C", "#D9822E"], ["#1A1A22", "#2A2A33"]]);
+  const k = { hsl: hexTillHsl("#9AA62E"), neutral: false };
+  // modellen använder ryggens övre del mest (kärnan 61°) och magens nedre del, näbben och ögonen lite
+  const mask = kroppsMask(d, w, h, k, anvand(w, rw, [[0, 0, 14], [0, 28, 31], [1, 10, 20], [2, 5, 8]]));
+  assert.equal(andelRuta(mask, w, h, rw, 0), 1, "hela kroppsrutan, också magens gröna ände");
+  assert.equal(andelRuta(mask, w, h, rw, 1), 0, "näbben");
+  assert.equal(andelRuta(mask, w, h, rw, 2), 0, "ögonen");
+  // R8-3a tog bara ±22° från kärnan: magens ände (115°) föll utanför
+  const p = rgbTillHsl(0x2f, 0x8c, 0x3a);
+  assert.equal(iKarnan(p, k), false);
+});
+
+test("R8-3a2: elefanten – grå kropp (två gråtoner) byts, gräddvita betar, rosa öron och mörka ögon behålls", () => {
+  const { d, w, h, rw } = atlas([["#5E6B73", "#87929A"], ["#EDE3CF", "#F7F1E4"], ["#D98DA0", "#E8A3B4"], ["#14161A", "#202228"]]);
+  const mask = kroppsMask(d, w, h, { hsl: rgbTillHsl(0x6b, 0x77, 0x80), neutral: true });
+  assert.equal(andelRuta(mask, w, h, rw, 0), 1, "kroppen");
+  assert.equal(andelRuta(mask, w, h, rw, 1), 0, "betarna");
+  assert.equal(andelRuta(mask, w, h, rw, 2), 0, "öronen");
+  assert.equal(andelRuta(mask, w, h, rw, 3), 0, "ögonen");
+});
+
+test("R8-3a2: en ruta bredvid i samma familj men med skarp kant växer inte in (steget är för stort)", () => {
+  const { d, w, h, rw } = atlas([["#3E8E41", "#3E8E41"], ["#9CCC65", "#9CCC65"]]);
+  const mask = kroppsMask(d, w, h, { hsl: hexTillHsl("#3E8E41"), neutral: false });
+  assert.equal(andelRuta(mask, w, h, rw, 1), 0);
+  assert.ok(MASK.steg < 60);
+});
+
+test("R8-3a2: material i kedja – en mage två nyanssteg bort via en mellanton hör till kroppen; hud mot röd dräkt gör det inte", () => {
+  const hm = (namn: string, h: number, yta: number): MatInfo => ({ namn, hsl: [h, 0.55, 0.45], yta });
+  // rygg 90°, mellanton 108°, mage 126° (36° från ryggen: R8-3a gav magen detalj), näbb 30°, ögon mörka
+  assert.deepEqual(roller([hm("rygg", 90, 0.5), hm("mellan", 108, 0.2), hm("mage", 126, 0.15), hm("nabb", 30, 0.1), mat("oga", "#111111", 0.05)]), ["kropp", "kropp", "kropp", "detalj", "detalj"]);
+  // R8-3a:s jultomte är oförändrad
+  const m = [mat("drakt", "#B71C1C", 0.4), mat("#8E1116", "#8E1116", 0.15), mat("hud", "#F1C27D", 0.1), mat("#FAFAFA", "#FAFAFA", 0.2), mat("#212121", "#212121", 0.1), mat("#FFC107", "#FFC107", 0.05)];
+  assert.deepEqual(roller(m), ["kropp", "kropp", "detalj", "detalj", "detalj", "detalj"]);
+  // datans behall stoppar kedjan
+  assert.deepEqual(roller([hm("rygg", 90, 0.5), hm("mellan", 108, 0.2), hm("mage", 126, 0.15)], { mellan: "behall" }), ["kropp", "detalj", "detalj"]);
+});
+
+test("R8-3a2: hörnfärger – kroppens hörn hittas (brun vas), svarta kanter behålls", () => {
+  const rgb = [130, 70, 25, 132, 72, 26, 128, 69, 24, 30, 28, 22];
+  const hk = hornKropp(rgb);
+  assert.ok(hk);
+  assert.deepEqual([...hk.kropp], [1, 1, 1, 0]);
+  assert.equal(hk.karna.neutral, false);
+  // grå hörnfärger (kuvertets skuggning): neutral kärna
+  assert.equal(hornKropp([235, 235, 235, 240, 240, 240, 160, 160, 160])?.karna.neutral, true);
+});
+
+test("R8-3a2: kroppsmönster ur data – regnbåge band (6 färger, ersätter regnbågen över djuret), ränder och prickar med ordets mönsterfärg", () => {
+  const v = (f: string) => {
+    const u = tolka(f);
+    assert.equal(u.typ, "skapad", f);
+    return (u as Extract<typeof u, { typ: "skapad" }>).varelse;
+  };
+  const rb = kroppsMonsterFor(v("en regnbågsfärgad katt"));
+  assert.equal(rb?.typ, "band");
+  assert.equal(rb?.farger.length, 6);
+  assert.deepEqual(effekterFor(v("en regnbågsfärgad katt")), ["regnbage"], "B6.5 oförändrad");
+  assert.deepEqual(effekterBredvid(v("en regnbågsfärgad katt"), true), [], "GLB: mönstret på kroppen i stället");
+  assert.deepEqual(effekterBredvid(v("en regnbågsfärgad katt"), false), ["regnbage"], "procedurkropp: effekten kvar");
+  assert.deepEqual(effekterBredvid(v("en glittrig katt"), true), ["glitter"]);
+  const r = kroppsMonsterFor(v("en röd och blå randig katt"));
+  assert.equal(r?.typ, "rander");
+  assert.deepEqual(r?.farger, ["#1E88E5"]);
+  assert.deepEqual(kroppsMonsterFor(v("en randig katt"))?.farger, [], "utan mönsterfärg: kroppens mörkare ton");
+  assert.equal(kroppsMonsterFor(v("en prickig hund"))?.typ, "prickar");
+  assert.equal(kroppsMonsterFor(v("en blå katt")), null);
+  assert.equal(kroppsMonsterFor({ monster: null, monsterfarg: null }), null);
+});
+
+test("R8-3a2: varje kroppsmönster i datan är ett mönster som ett ord kan ge, och har en känd typ", () => {
+  const monster = new Set<string>();
+  for (const o of ORD.ord) if ((o.del as { monster?: string } | undefined)?.monster) monster.add(`monster:${(o.del as { monster: string }).monster}`);
+  const km = (attributJson as { kroppsmonster: Record<string, { typ?: string }> }).kroppsmonster;
+  for (const [k, r] of Object.entries(km)) {
+    if (k.startsWith("_")) continue;
+    assert.ok(monster.has(k), `${k} ges inte av något ord`);
+    assert.ok(["band", "rander", "prickar"].includes(r.typ ?? ""), `${k}: okänd typ ${r.typ}`);
+  }
+});
