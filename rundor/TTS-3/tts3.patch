+      if (aktiv === k) aktiv = null;
+      k.stang();
+    }, Math.max(0, ms));
+  },
+  spelar(text: string) {
+    const k = aktiv;
+    if (!k || k.text !== text) return;
+    k.start ??= performance.now();
+    // vaktpost om 'ended' aldrig kommer: replikens längd + marginal
+    klocka.satt(k, Math.max(k.las, k.ms + EFTER_ROST_MS) + 4000);
+  },
+  klar(text: string) {
+    const k = aktiv;
+    if (!k || k.text !== text) return;
+    const nu = performance.now();
+    if (k.start === null) return klocka.satt(k, k.t0 + bannerTidMs(k) - nu); // spelades aldrig: vanliga tiden
+    klocka.satt(k, Math.max(k.start + k.las, nu + EFTER_ROST_MS) - nu);
+  },
+  utanRost() {
+    const k = aktiv;
+    if (k) klocka.satt(k, Math.max(k.t0 + k.las, performance.now()) - performance.now());
+  },
+  slapp() {
+    if (aktiv) window.clearTimeout(aktiv.timer);
+    aktiv = null;
+  },
+};
+function bannerTidMs(k: Klocka) {
+  return k.ms > 0 && useMinne.getState().ljudPa ? Math.max(k.las, k.ms + EFTER_ROST_MS) : k.las;
+}
+
+/** TTS-3: startar bannerns klocka och anropar stang() när bannern ska gå. Returnerar ett timer-id (för clearTimeout i
+ *  anroparen, som förut); klockan själv släpps av nästa banner eller av ett tryck (tystna). */
+export function bannerKlocka(text: string, bas: number, stang: () => void): number {
+  klocka.slapp();
+  const t = normalisera(text);
+  const k: Klocka = { text: t, las: Math.max(bas, lasbarTid(t)), ms: lasTid(t), t0: performance.now(), start: null, timer: 0, stang };
+  if (typeof window === "undefined" || !useMinne.getState().ljudPa || k.ms === 0) {
+    k.timer = window.setTimeout(stang, k.las);
+    return k.timer;
+  }
+  aktiv = k;
+  if (nuText === t) k.start = k.t0; // rösten läser redan samma text
+  const vanlig = () => {
+    // vanliga tiden har gått utan att rösten börjat: ligger repliken kvar i kön väntar bannern till ROST_START_MS
+    const kvar = k.t0 + ROST_START_MS - performance.now();
+    if (aktiv === k && k.start === null && kvar > 0 && ko.some((x) => x.text === t)) {
+      k.timer = window.setTimeout(vanlig, kvar);
+      return;
+    }
+    if (aktiv === k) aktiv = null;
+    stang();
+  };
+  k.timer = window.setTimeout(vanlig, bannerTidMs(k));
+  if (k.start !== null) klocka.spelar(t);
+  return k.timer;
+}
+
+/** Läser upp bannrar (alla slag) när de visas, en gång per banner – före pratbubblorna i kön (TTS-3). */
 export function useRostBannrar(banners: { id: number; text: string }[]) {
   useEffect(() => {
-    for (const b of banners) sag(b.text, `banner:${b.id}`);
+    for (const b of banners) sag(b.text, `banner:${b.id}`, true);
   }, [banners]);
 }
 
diff --git a/src/spel/tts3.test.ts b/src/spel/tts3.test.ts
new file mode 100644
index 0000000..9654ea4
--- /dev/null
+++ b/src/spel/tts3.test.ts
@@ -0,0 +1,36 @@
+// TTS-3: guiden räknar bara djur barnet själv väckt (introts kanin och katt räknas inte), äldre sparningar flyttas över,
+// uttalsregeln för stammen "ekorr" och att spelets styr-API (window.__troll) bara finns i dev och under prov.
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import { test } from "node:test";
+import rostJson from "../../data/rost.json" with { type: "json" };
+import { aktivtSteg } from "./forstaStunden.ts";
+import { franSparning } from "./minne.ts";
+
+const album = (...k: string[]) => Object.fromEntries(k.map((x) => [x, { formel: `en ${x}`, poang: 1, niva: "vanlig", hjartan: 0 }]));
+
+test("TTS-3: efter introt (kanin + katt i albumet) visar guiden 'skriv ett djur'", () => {
+  const efterIntro = franSparning({ version: 2, introSedd: true, albumKropp: album("kanin", "katt"), egnaDjur: 0 });
+  assert.equal(efterIntro.egnaDjur, 0);
+  assert.equal(aktivtSteg(efterIntro as unknown as Record<string, unknown>)?.steg.id, "forsta-ordet");
+});
+
+test("TTS-3: äldre sparning utan egnaDjur – introts två djur räknas bort, inget steg går bakåt", () => {
+  assert.equal(franSparning({ version: 2, introSedd: true, albumKropp: album("kanin", "katt") }).egnaDjur, 0);
+  assert.equal(franSparning({ version: 2, introSedd: true, albumKropp: album("kanin", "katt", "hund") }).egnaDjur, 1);
+  assert.equal(franSparning({ version: 2, introSedd: true, albumKropp: album("kanin", "katt", "hund", "gris", "ko", "hast", "anka") }).egnaDjur, 5);
+});
+
+test("TTS-3: uttalsregeln 'ekorr' gäller stammen, inte bara exakta ord", () => {
+  const r = rostJson as unknown as { uttal: Record<string, string>; uttal_stam: Record<string, string>; omtag: Record<string, unknown> };
+  assert.equal(r.uttal_stam.ekorr, "ehkorr");
+  assert.equal(r.uttal.Ekorren, undefined, "den exakta regeln är ersatt av stamregeln");
+  assert.equal(typeof r.omtag, "object");
+});
+
+test("TTS-3: window.__troll sätts bara i dev eller när ett prov styr webbläsaren", () => {
+  const s = fs.readFileSync("src/spel/Spel.tsx", "utf8");
+  const rader = s.split("\n").filter((r) => /window\.__troll\s*=/.test(r));
+  assert.equal(rader.length, 1);
+  assert.match(rader[0]!, /if \(import\.meta\.env\.DEV \|\| navigator\.webdriver === true\) window\.__troll = api/);
+});
diff --git a/src/spel/tts3fix.test.ts b/src/spel/tts3fix.test.ts
new file mode 100644
index 0000000..5f712e3
--- /dev/null
+++ b/src/spel/tts3fix.test.ts
@@ -0,0 +1,101 @@
+// TTS-3-fix: kön med riktiga texter ur manifestet och ett låtsat Audio-element (node). En banner avbryter en guiderad som
+// läses (uttoning, bannerns röst börjar direkt, den avbrutna läses inte om). Ett tryck (tystna) stoppar rösten som spelar
+// och tar bort en bannerröst som ligger i kön innan den hunnit starta.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import manifest from "../../data/rost-manifest.json" with { type: "json" };
+
+type Spel = { f: string; start: number; paus: number | null; volym: number[] };
+const spelat: Spel[] = [];
+class FakeAudio {
+  src: string;
+  paused = true;
+  rec: Spel | null = null;
+  private l = new Map<string, (() => void)[]>();
+  _volume = 1;
+  constructor(src: string) {
+    this.src = src;
+  }
+  get volume() {
+    return this._volume;
+  }
+  set volume(v: number) {
+    this._volume = v;
+    this.rec?.volym.push(v);
+  }
+  addEventListener(t: string, f: () => void) {
+    this.l.set(t, [...(this.l.get(t) ?? []), f]);
+  }
+  play() {
+    this.paused = false;
+    this.rec = { f: this.src, start: performance.now(), paus: null, volym: [] };
+    spelat.push(this.rec);
+    return Promise.resolve();
+  }
+  pause() {
+    if (!this.paused && this.rec) this.rec.paus ??= performance.now();
+    this.paused = true;
+  }
+  slut() {
+    this.paused = true;
+    for (const f of this.l.get("ended") ?? []) f();
+  }
+}
+const g = globalThis as unknown as Record<string, unknown>;
+g.window = globalThis;
+g.Audio = FakeAudio;
+const { useMinne } = await import("./minne.ts");
+const rost = await import("./rost.ts");
+const { rostPlan } = await import("./rostManifest.ts");
+useMinne.setState({ ljudPa: true });
+
+const enkla = Object.values((manifest as unknown as { rader: Record<string, { t: string }> }).rader)
+  .map((r) => r.t)
+  .filter((t) => !t.includes(" /") && rostPlan(t)?.delar.length === 1);
+const [guide, bannerA, bannerB] = enkla.slice(0, 3) as [string, string, string];
+const fil = (t: string) => (rostPlan(t)!.delar[0] as { f: string }).f;
+const vanta = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+test("TTS-3-fix: en banner avbryter guideraden som läses – uttoning ≈ 150 ms, bannerns röst börjar direkt, guiden läses inte om", async () => {
+  spelat.length = 0;
+  rost.sag(guide, "g1");
+  await vanta(5);
+  assert.equal(spelat.length, 1);
+  assert.equal(spelat[0]!.f, fil(guide));
+  rost.sag(bannerA, "b1", true);
+  await vanta(5);
+  assert.equal(spelat.length, 2, "bannerns röst började direkt, utan att vänta på guiden");
+  assert.equal(spelat[1]!.f, fil(bannerA));
+  assert.equal(spelat[0]!.paus, null, "guiden tonas ut, inte klipps");
+  await vanta(rost.TONA_MS + 80);
+  assert.ok(spelat[0]!.paus !== null, "guiden är pausad efter uttoningen");
+  assert.ok(spelat[0]!.volym.length >= 2 && spelat[0]!.volym.at(-1)! < 0.6, "volymen sänktes stegvis");
+  assert.equal(spelat[1]!.paus, null, "bannerns röst spelar vidare");
+  rost.tystna();
+  await vanta(5);
+  assert.equal(spelat.filter((s) => s.f === fil(guide)).length, 1, "den avbrutna guideraden läses inte om");
+});
+
+test("TTS-3-fix: ett tryck stoppar rösten som spelar och tar bort en bannerröst som ligger i kön innan den startar", async () => {
+  spelat.length = 0;
+  rost.sag(bannerA, "b2", true);
+  await vanta(5);
+  rost.sag(bannerB, "b3", true); // en banner avbryter inte en annan – den ligger i kön
+  rost.sag(guide, "g2");
+  await vanta(5);
+  assert.deepEqual(spelat.map((s) => s.f), [fil(bannerA)], "B och guiden ligger i kön");
+  rost.tystna();
+  assert.ok(spelat[0]!.paus !== null, "rösten som spelade pausades");
+  await vanta(rost.TONA_MS + 50);
+  assert.deepEqual(spelat.map((s) => s.f), [fil(bannerA)], "inget ur kön startade efter trycket");
+});
+
+test("TTS-3-fix: ett tryck under uttoningen stoppar också den uttonade rösten direkt", async () => {
+  spelat.length = 0;
+  rost.sag(guide, "g3");
+  await vanta(5);
+  rost.sag(bannerB, "b4", true);
+  await vanta(5);
+  rost.tystna();
+  assert.ok(spelat.every((s) => s.paus !== null), "både den uttonade guiden och bannerns röst är pausade");
+});
