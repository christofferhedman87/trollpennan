@@ -0,0 +1,83 @@
+// B1.3a: platser som data – upplåsning, milstolpe, yta och sparning per plats.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { PLATSER, klaraPerPlats, milstolpeNadd, platsMed, tillVarld, upplast, type Matt, type Plats } from "./platser.ts";
+import { franSparning, useMinne } from "./minne.ts";
+import type { Varelse } from "../tolk/typer.ts";
+
+// Skogen ur utkastet (data/platser.json har bara ängen tills datapaketet B2 körs).
+const SKOGEN: Plats = {
+  id: "skogen", namn: "Skogen", ordning: 1,
+  upplasning: { nagon: [{ typ: "skapelser", omrade: "ang", min: 3 }] },
+  milstolpe: { nagon: [{ typ: "uppdrag_klara", omrade: "skogen", min: 5 }, { typ: "skapelser", omrade: "skogen", min: 8 }], final: "skog-final-minnesljus", las_upp: "sjon" },
+  miljo: {}, zoner: [], start: [], uppdrag: [],
+};
+const LISTA = [...PLATSER, SKOGEN];
+const m = (ang: number, skog = 0, klaraSkog = 0, oppnade: string[] = []): Matt => ({ skapelser: { ang, skogen: skog }, klara: { skogen: klaraSkog }, oppnade });
+
+test("B1.3a: data/platser.json har ängen, alltid öppen", () => {
+  assert.equal(platsMed("ang")?.namn, "Ängen");
+  assert.ok(upplast("ang", m(0)));
+  assert.ok(!upplast("finnsinte", m(99)));
+});
+
+test("B1.3a: skogen låses upp av 3 skapelser på ängen och förblir öppen", () => {
+  assert.ok(!upplast("skogen", m(2), LISTA), "2 skapelser: låst");
+  assert.ok(upplast("skogen", m(3), LISTA), "3 skapelser: öppen");
+  assert.ok(upplast("skogen", m(0, 0, 0, ["skogen"]), LISTA), "en gång öppnad förblir öppen");
+});
+
+test("B1.3a: milstolpen nås med 5 klara uppdrag eller 8 skapelser", () => {
+  assert.ok(!milstolpeNadd("skogen", m(3, 7, 4), LISTA));
+  assert.ok(milstolpeNadd("skogen", m(3, 0, 5), LISTA));
+  assert.ok(milstolpeNadd("skogen", m(3, 8, 0), LISTA));
+  assert.ok(!milstolpeNadd("ang", m(99)), "ängen har ingen milstolpe");
+});
+
+test("B1.3a: klaraPerPlats räknar per omrade utan finaler", () => {
+  const u = [{ id: "a", omrade: "skogen" }, { id: "b", omrade: "skogen" }, { id: "f", omrade: "skogen", final: true }, { id: "c", omrade: "ang" }];
+  assert.deepEqual(klaraPerPlats({ a: "klar", b: "pagar", f: "klar", c: "klar" }, u), { skogen: 1, ang: 1 });
+});
+
+test("B1.3a: tillVarld ger hörnen i ytan", () => {
+  assert.deepEqual(tillVarld(0, 0), [-2.4, -3.2]);
+  assert.deepEqual(tillVarld(1, 1), [2.4, 1.0]);
+});
+
+const djur = { uid: "x", kropp: "kanin", formel: "en kanin", beskrivning: "en kanin", skapad: 1, skala: 1, alpha: 1, formagor: [], tillbehor: [], overraskningar: [] };
+
+test("B1.3a: gammal sparning utan platsfälten laddas med plats ang och djuren kvar", () => {
+  const d = franSparning({ version: 2, ang: [djur], garden: [], stjarnor: 4 });
+  assert.equal(d.plats, "ang");
+  assert.deepEqual(d.platsSkapelser, {});
+  assert.deepEqual(d.oppnadePlatser, []);
+  assert.equal(d.ang.length, 1);
+  assert.equal(d.ang[0]!.kropp, "kanin");
+  assert.equal(d.stjarnor, 4);
+  assert.equal(franSparning({ version: 2, ang: [], garden: [], stjarnor: 0, platsSkapelser: { skogen: [{ trasig: 1 }] } }).platsSkapelser.skogen, undefined, "trasig platslista ger standard");
+});
+
+test("B1.3a: en skapelse i skogen hamnar i platsSkapelser.skogen, ängen oförändrad", () => {
+  const s = useMinne.getState();
+  s.aterstall();
+  const v = { ...djur } as unknown as Varelse;
+  s.laggPaAng(v, 1);
+  const angFore = useMinne.getState().ang.map((a) => a.uid);
+  assert.equal(angFore.length, 1);
+  useMinne.setState({ plats: "skogen" });
+  const { nya } = useMinne.getState().laggPaAng(v, 2);
+  const e = useMinne.getState();
+  assert.equal(nya.length, 2);
+  assert.equal(e.platsSkapelser.skogen?.length, 2);
+  assert.deepEqual(e.ang.map((a) => a.uid), angFore, "ang är oförändrad");
+  for (let i = 0; i < 12; i++) useMinne.getState().laggPaAng(v, 1);
+  assert.equal(useMinne.getState().platsSkapelser.skogen?.length, 10, "samma tak på 10");
+  useMinne.getState().aterstall();
+});
+
+test("B1.3a: bytPlats går bara till upplåsta platser", () => {
+  useMinne.getState().aterstall();
+  assert.equal(useMinne.getState().bytPlats("finnsinte"), false);
+  assert.equal(useMinne.getState().plats, "ang");
+  assert.equal(useMinne.getState().bytPlats("ang"), true);
+});
diff --git a/src/spel/platser.ts b/src/spel/platser.ts
new file mode 100644
index 0000000..adcb1d9
--- /dev/null
+++ b/src/spel/platser.ts
@@ -0,0 +1,100 @@
+// B1.3a: platserna som data (data/platser.json). Ren logik, ingen React, ingen Zustand.
+// En ny plats är en datarad; upplåsning och milstolpe är villkor i datan, aldrig kod per plats.
+import platserJson from "../../data/platser.json" with { type: "json" };
+import { SKRIV } from "./aventyr.ts";
+import type { Sparad } from "./brygga.ts";
+
+export type Villkor = { typ: "skapelser" | "uppdrag_klara"; omrade: string; min: number };
+export type Villkorsgrupp = { nagon: Villkor[] };
+export type Milstolpe = Villkorsgrupp & { final?: string | null; las_upp?: string | null };
+export type Zon = { id: string; typ: string; rekt: [number, number, number, number] };
+export type Startobjekt = { ord: string; x: number; y: number; skala?: number; zon?: string };
+export type Plats = {
+  id: string;
+  namn: string;
+  ordning: number;
+  tema?: string;
+  upplasning: Villkorsgrupp;
+  milstolpe: Milstolpe | null;
+  miljo: Record<string, unknown>;
+  zoner: Zon[];
+  start: Startobjekt[];
+  ljud?: unknown;
+  intro?: unknown;
+  final_fore?: unknown;
+  hemliga?: string[];
+  uppdrag: string[];
+};
+export type PlatsData = { version: number; yta: { x: [number, number]; z: [number, number] }; platser: Plats[]; beloningar: unknown[] };
+/** Det som villkoren mäts mot. */
+export type Matt = { skapelser: Record<string, number>; klara: Record<string, number>; oppnade?: string[] };
+
+export const PLATSDATA = platserJson as unknown as PlatsData;
+export const PLATSER: Plats[] = [...PLATSDATA.platser].sort((a, b) => a.ordning - b.ordning);
+export const START_PLATS = "ang";
+export const TAK_PER_PLATS = 10;
+
+export function platsMed(id: string, platser: Plats[] = PLATSER): Plats | undefined {
+  return platser.find((p) => p.id === id);
+}
+
+export function villkorNatt(v: Villkor, m: Matt): boolean {
+  const n = v.typ === "skapelser" ? m.skapelser[v.omrade] ?? 0 : m.klara[v.omrade] ?? 0;
+  return n >= v.min;
+}
+
+function nagonNadd(g: Villkorsgrupp | null | undefined, m: Matt): boolean {
+  return !!g && g.nagon.some((v) => villkorNatt(v, m));
+}
+
+/** Ängen är alltid öppen. En plats som en gång öppnats förblir öppen. Annars räcker ett villkor ur `nagon`. */
+export function upplast(id: string, m: Matt, platser: Plats[] = PLATSER): boolean {
+  if (id === START_PLATS) return true;
+  const p = platsMed(id, platser);
+  if (!p) return false;
+  if (m.oppnade?.includes(id)) return true;
+  return nagonNadd(p.upplasning, m);
+}
+
+/** Får platsens final erbjudas? */
+export function milstolpeNadd(id: string, m: Matt, platser: Plats[] = PLATSER): boolean {
+  return nagonNadd(platsMed(id, platser)?.milstolpe, m);
+}
+
+/** Klara skriv-uppdrag per `omrade`, utan finaler. */
+export function klaraPerPlats(status: Record<string, "pagar" | "klar">, uppdrag: { id: string; omrade: string; final?: boolean }[] = SKRIV): Record<string, number> {
+  const ut: Record<string, number> = {};
+  for (const u of uppdrag) if (status[u.id] === "klar" && !u.final) ut[u.omrade] = (ut[u.omrade] ?? 0) + 1;
+  return ut;
+}
+
+/** Måtten ur sparningen. Ängens skapelser = djur på ängen + sovande (de har skapats där). */
+export function mattUr(d: { ang: Sparad[]; sovande: Sparad[]; platsSkapelser: Record<string, Sparad[]>; oppnadePlatser: string[]; uppdrag: Record<string, "pagar" | "klar"> }): Matt {
+  const skapelser: Record<string, number> = { [START_PLATS]: d.ang.length + d.sovande.length };
+  for (const [id, lista] of Object.entries(d.platsSkapelser)) if (id !== START_PLATS) skapelser[id] = lista.length;
+  return { skapelser, klara: klaraPerPlats(d.uppdrag), oppnade: d.oppnadePlatser };
+}
+
+/** Platsens yta (x 0–1 vänster→höger, y 0–1 bak→fram) → världskoordinater [wx, wz]. */
+export function tillVarld(x: number, y: number, yta: PlatsData["yta"] = PLATSDATA.yta): [number, number] {
+  const [x0, x1] = yta.x;
+  const [z0, z1] = yta.z;
+  return [x0 + (x1 - x0) * x, z0 + (z1 - z0) * y];
+}
+
+/** Lägg nya skapelser på en lista med tak; de äldsta somnar (samma regel som ängen). Ren, för minne.ts. */
+export function laggMedTak(lista: Sparad[], sovande: Sparad[], nya: Sparad[], tak = TAK_PER_PLATS): { lista: Sparad[]; sovande: Sparad[]; somnade: Sparad[] } {
+  let l = [...lista];
+  let s = [...sovande];
+  const somnade: Sparad[] = [];
+  for (const n of nya) {
+    while (l.length >= tak) {
+      const old = l.shift();
+      if (!old) break;
+      s = [...s, old].slice(-40);
+      somnade.push(old);
+    }
+    l = [...l, n];
+  }
+  return { lista: l, sovande: s, somnade };
+}
