-    return kropp === "groda" || kropp === "fisk" ? bas * 1.4 : bas;
-  }
-  if (id === "halsduk") {
-    // Yttre diameter i modellrum är ungefär 0,22 * 2 * 1,35. Skalan gör ringen synlig på mobil.
-    return Math.max(0.55, Math.min(a.bredd * 1.45, a.hojd * 0.7));
