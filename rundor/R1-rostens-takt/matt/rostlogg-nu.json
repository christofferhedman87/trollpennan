 "rost": [
  {
   "t": 24368.5,
   "text": "Guldord! Du skrev katt alldeles själv!",
   "fil": "/ljud/rost/97a4f5394ddf5481.mp3",
   "satt": "mall",
   "delar": 3,
   "dynamisk": false
  },
  {
   "t": 30129.5,
   "text": "Tryck på Pennans bok och skriv ett djur!",
   "fil": "/ljud/rost/4729db4b30aaecc2.mp3",
   "satt": "fil",
   "delar": 1,
   "dynamisk": false
  },
  {
   "t": 31835.09999999404,
   "text": "+1 stjärna!",
   "fil": "/ljud/rost/3e9dc37fe86a6d46.mp3",
   "satt": "fil",
   "delar": 1,
   "dynamisk": false
  },
  {
   "t": 33982.70000001788,
   "text": "Mjau! Jag är en liten bebis med morrhår och mjuka tassar.",
   "fil": "/ljud/rost/8e9b4842495c1f94.mp3",
   "satt": "fil",
   "delar": 1,
   "dynamisk": false
  },
  {
   "t": 39035.90000000596,
   "text": "Bengtsson vill be dig om något. Tryck på honom!",
   "fil": "/ljud/rost/e6fd5454d3584d43.mp3",
   "satt": "fil",
   "delar": 1,
   "dynamisk": false
  },
  {
   "t": 43452.80000001192,
   "text": "Hej! Här kommer en katt!",
   "fil": "/ljud/rost/111b0ad1bd7eeb7c.mp3",
   "satt": "mall",
   "delar": 2,
   "dynamisk": false
  },
  {
   "t": 48186.59999999404,
   "text": "Wow, ett ovanligt djur! Ett sådant har du inte haft förut.",
   "fil": "/ljud/rost/7a7af21b73c23d20.mp3",
   "satt": "mall",
   "delar": 3,
   "dynamisk": false
  },
  {
   "t": 55765.90000000596,
   "text": "Hej! Här kommer en blå hund!",
   "fil": null,
   "satt": "tyst",
   "dynamisk": true
  },
  {
   "t": 57467.5,
