diff --git a/src/spel/p22.test.ts b/src/spel/p22.test.ts
new file mode 100644
index 0000000..0685172
--- /dev/null
+++ b/src/spel/p22.test.ts
@@ -0,0 +1,92 @@
+// P2-2: titelskärmen (förslag A) – när den visas, "Börja om med en ny värld" med ångra inom sessionen, texterna i data.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { ANGRA_NYCKEL, PROV_NYCKEL, angraBorjaOm, borjaOmMedKopia, harKopia, spelNycklar, visaTitelVidStart } from "./start.ts";
+import { FORSTA } from "./forstaStunden.ts";
+import introJson from "../../data/intro.json" with { type: "json" };
+
+class Minne implements Pick<Storage, "getItem" | "setItem" | "removeItem" | "key" | "length"> {
+  m = new Map<string, string>();
+  tak = Infinity;
+  get length() {
+    return this.m.size;
+  }
+  key(i: number) {
+    return [...this.m.keys()][i] ?? null;
+  }
+  getItem(k: string) {
+    return this.m.get(k) ?? null;
+  }
+  setItem(k: string, v: string) {
+    if (v.length > this.tak) throw new Error("QuotaExceededError");
+    this.m.set(k, v);
+  }
+  removeItem(k: string) {
+    this.m.delete(k);
+  }
+}
+
+const varld = () => {
+  const l = new Minne();
+  l.setItem("trollpennan-spel", JSON.stringify({ introSedd: true, ang: [{ uid: "a1", formel: "en katt" }] }));
+  l.setItem("trollpennan-ljud", "på");
+  l.setItem("annat", "rör inte");
+  return l;
+};
+
+test("P2-2: titelskärmen visas alltid för barn, för prov bara när de ber om den", () => {
+  assert.equal(visaTitelVidStart(false, null), true);
+  assert.equal(visaTitelVidStart(true, null), false);
+  const s = new Minne();
+  assert.equal(visaTitelVidStart(true, s), false);
+  s.setItem(PROV_NYCKEL, "1");
+  assert.equal(visaTitelVidStart(true, s), true);
+});
+
+test("P2-2: börja om tömmer bara spelets nycklar och sparar en kopia i sessionen", () => {
+  const l = varld();
+  const s = new Minne();
+  assert.deepEqual(spelNycklar(l).sort(), ["trollpennan-ljud", "trollpennan-spel"]);
+  assert.equal(borjaOmMedKopia(l, s), true);
+  assert.deepEqual(spelNycklar(l), []);
+  assert.equal(l.getItem("annat"), "rör inte");
+  assert.equal(harKopia(s), true);
+});
+
+test("P2-2: ångra lägger tillbaka den gamla världen exakt och tar bort kopian", () => {
+  const l = varld();
+  const fore = l.getItem("trollpennan-spel");
+  const s = new Minne();
+  borjaOmMedKopia(l, s);
+  l.setItem("trollpennan-spel", JSON.stringify({ introSedd: true, ang: [] }));
+  assert.equal(angraBorjaOm(l, s), true);
+  assert.equal(l.getItem("trollpennan-spel"), fore);
+  assert.equal(l.getItem("trollpennan-ljud"), "på");
+  assert.equal(harKopia(s), false);
+  assert.equal(angraBorjaOm(l, s), false);
+});
+
+test("P2-2: får kopian inte plats börjar spelet ändå om (ingen ångra-knapp)", () => {
+  const l = varld();
+  const s = new Minne();
+  s.tak = 10;
+  assert.equal(borjaOmMedKopia(l, s), false);
+  assert.deepEqual(spelNycklar(l), []);
+  assert.equal(harKopia(s), false);
+  assert.equal(borjaOmMedKopia(varld(), null), false);
+});
+
+test("P2-2: titelns texter ligger i data och är som Christoffer bestämde", () => {
+  const t = FORSTA.titel;
+  assert.equal(t.borja_om, "Börja om med en ny värld");
+  assert.equal(t.fraga, "Din värld med alla djur försvinner. Är du säker?");
+  assert.equal(t.nej, "Nej, tillbaka");
+  assert.equal(t.ja, "Ja, börja om");
+  for (const [k, v] of Object.entries(t)) if (!k.startsWith("_")) assert.ok(typeof v === "string" && v.length > 0, k);
+  assert.equal(new Minne().getItem(ANGRA_NYCKEL), null);
+});
+
+test("P2-2: ljudraden k – a – tt stavar ordet", () => {
+  const s = introJson.skriv as { ord: string; ljud?: string[] };
+  assert.equal(s.ljud?.join(""), s.ord);
+});
diff --git a/src/spel/start.ts b/src/spel/start.ts
new file mode 100644
index 0000000..a09ecc5
--- /dev/null
+++ b/src/spel/start.ts
@@ -0,0 +1,84 @@
+// P2-2: titelskärmens läge och "börja om" med ångra inom sessionen. Ren logik + en liten zustand-butik, ingen React-vy.
+import { create } from "zustand";
+
+type Lagring = Pick<Storage, "getItem" | "setItem" | "removeItem" | "key" | "length">;
+
+/** Nyckeln i sessionStorage där den gamla världen ligger efter "Börja om" (finns kvar tills fliken stängs). */
+export const ANGRA_NYCKEL = "trollpennan-angra";
+/** Prov (Playwright, navigator.webdriver) ser titelskärmen bara om de ber om den, så att äldre prov går som förut. */
+export const PROV_NYCKEL = "p2-titel-prov";
+
+export function visaTitelVidStart(webdriver: boolean, session: Pick<Storage, "getItem"> | null): boolean {
+  if (!webdriver) return true;
+  try {
+    return session?.getItem(PROV_NYCKEL) === "1";
+  } catch {
+    return false;
+  }
+}
+
+export const useStart = create<{ titelOppen: boolean; stang: () => void }>((set) => ({
+  titelOppen: typeof window !== "undefined" && visaTitelVidStart(navigator.webdriver === true, window.sessionStorage),
+  stang: () => set({ titelOppen: false }),
+}));
+
+/** Alla spelets nycklar i localStorage (samma urval som menyns "Börja om"). */
+export function spelNycklar(lokal: Lagring): string[] {
+  const ut: string[] = [];
+  for (let i = 0; i < lokal.length; i++) {
+    const k = lokal.key(i);
+    if (k?.startsWith("trollpennan")) ut.push(k);
+  }
+  return ut;
+}
+
+/** Sparar den gamla världen i sessionStorage och tömmer den lokala. Returnerar true om kopian gick att spara. */
+export function borjaOmMedKopia(lokal: Lagring, session: Lagring | null): boolean {
+  const nycklar = spelNycklar(lokal);
+  let kopia = false;
+  if (session) {
+    try {
+      const data: Record<string, string> = {};
+      for (const k of nycklar) data[k] = lokal.getItem(k) ?? "";
+      session.setItem(ANGRA_NYCKEL, JSON.stringify({ tid: Date.now(), data }));
+      kopia = true;
+    } catch {
+      kopia = false;
+    }
+  }
+  for (const k of nycklar) lokal.removeItem(k);
+  return kopia;
+}
+
+export function harKopia(session: Pick<Storage, "getItem"> | null): boolean {
+  try {
+    return !!session?.getItem(ANGRA_NYCKEL);
+  } catch {
+    return false;
+  }
+}
+
+/** Lägger tillbaka den gamla världen (ersätter det som finns nu) och tar bort kopian. */
+export function angraBorjaOm(lokal: Lagring, session: Lagring): boolean {
+  try {
+    const raw = session.getItem(ANGRA_NYCKEL);
+    if (!raw) return false;
+    const { data } = JSON.parse(raw) as { data: Record<string, string> };
+    for (const k of spelNycklar(lokal)) lokal.removeItem(k);
+    for (const [k, v] of Object.entries(data)) if (k.startsWith("trollpennan")) lokal.setItem(k, v);
+    session.removeItem(ANGRA_NYCKEL);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** Ladda om utan att spelet hinner spara tillbaka den gamla världen (samma skydd som menyns "Börja om"). */
+export function laddaOmRent(lokal: Lagring, behall?: Record<string, string>) {
+  const vakt = () => {
+    for (const k of spelNycklar(lokal)) if (!behall || !(k in behall)) lokal.removeItem(k);
+    if (behall) for (const [k, v] of Object.entries(behall)) lokal.setItem(k, v);
+  };
+  window.addEventListener("pagehide", vakt);
+  window.location.reload();
+}
