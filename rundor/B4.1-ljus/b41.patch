@@ -0,0 +1,53 @@
+// B4.1: det barnet skapar lyser i grottan (data/platser.json), högst 4 ljus – de senast skapade.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import entiteter from "../../data/entiteter.json" with { type: "json" };
+import { LJUS_STYRKA, MAX_LJUS, ljuskallaFor, lyserVad, valjLjus, ytansBredd } from "./ljuskalla.ts";
+import { platsMed } from "./platser.ts";
+
+const sak = (uid: string, kropp: string, med: string[] = [], skapad = 1) => ({ uid, kropp, tillbehor: med.map((id) => ({ id })) as never, skapad });
+
+test("B4.1: grottans ljuskälla kommer ur data, radie som andel av ytans bredd", () => {
+  const g = platsMed("grottan")!;
+  const l = g.miljo.ljuskalla_skapad as { radie: number; intensitet: number; farg: string };
+  const k = ljuskallaFor(g)!;
+  assert.ok(k, "grottan har ljus");
+  assert.equal(ytansBredd(), 11);
+  assert.ok(Math.abs(k.avstand - l.radie * 11) < 1e-9, `avstånd ${k.avstand}`);
+  assert.ok(k.avstand > 2 && k.avstand < 3.2, "ungefär som 2.5 i den gamla prompten");
+  assert.equal(k.intensitet, l.intensitet * LJUS_STYRKA);
+  assert.equal(k.farg, l.farg);
+  assert.ok(k.entiteter.includes("lykta"));
+  const ent = (entiteter as unknown as { entiteter: Record<string, { modell?: string }> }).entiteter;
+  for (const e of k.entiteter) assert.ok(ent[e]?.modell, `${e} finns i entiteter.json med modell`);
+  assert.ok(!k.entiteter.includes("kanin"));
+});
+
+test("B4.1: ängen har inget ljus; en plats utan lista eller med trasig data ger inget ljus", () => {
+  assert.equal(ljuskallaFor(platsMed("ang")), null);
+  assert.equal(ljuskallaFor({ miljo: { ljuskalla_skapad: { radie: 0.2, intensitet: 0.3, farg: "#FFD58A" } } }), null, "ingen entiteter-lista");
+  const k = ljuskallaFor({ miljo: { ljuskalla_skapad: { radie: -1, intensitet: "x", farg: "röd", entiteter: ["lykta", 3] } } }, 10)!;
+  assert.deepEqual(k, { farg: "#FFD58A", intensitet: 0.35 * LJUS_STYRKA, avstand: 2.4, entiteter: ["lykta"] }, "standardvärden");
+});
+
+test("B4.1: det som lyser är kroppen ('en lykta') eller saken djuret har med sig ('en kanin med en lykta')", () => {
+  const k = ljuskallaFor(platsMed("grottan"))!;
+  assert.equal(lyserVad(sak("a", "lykta"), k), "lykta");
+  assert.equal(lyserVad(sak("b", "kanin", ["lykta"]), k), "lykta");
+  assert.equal(lyserVad(sak("c", "rav", ["bok", "fackla"]), k), "fackla");
+  assert.equal(lyserVad(sak("d", "kanin", ["bok"]), k), null);
+  assert.equal(lyserVad(sak("e", "kanin"), k), null);
+});
+
+test("B4.1: högst 4 ljus, de senast skapade behålls; saker som inte lyser räknas inte", () => {
+  const k = { entiteter: ["lykta"] };
+  const djur = [1, 2, 3, 4, 5, 6].map((n) => sak(`l${n}`, "kanin", ["lykta"], n * 1000));
+  djur.splice(2, 0, sak("k", "kanin", [], 99999));
+  const v = valjLjus(djur, k);
+  assert.equal(MAX_LJUS, 4);
+  assert.deepEqual([...v.keys()].sort(), ["l3", "l4", "l5", "l6"]);
+  assert.equal(v.get("l6"), "lykta");
+  const lika = [sak("x", "lykta", [], 5), sak("y", "lykta", [], 5)];
+  assert.deepEqual([...valjLjus(lika, k, 1).keys()], ["y"], "samma tid → den senare i listan");
+  assert.equal(valjLjus(djur, k, 0).size, 0);
+});
diff --git a/src/spel/ljuskalla.ts b/src/spel/ljuskalla.ts
new file mode 100644
index 0000000..affb3a4
--- /dev/null
+++ b/src/spel/ljuskalla.ts
@@ -0,0 +1,49 @@
+// B4.1: saker som barnet skapar lyser på platser där datan säger det (data/platser.json `miljo.ljuskalla_skapad`).
+// Ren logik utan three och React: vilken plats har ljus, hur stort/starkt, vilka entiteter lyser och vilka skapelser som får
+// ett av de högst 4 ljusen (de senast skapade). Platsdekoren lyser aldrig – bara det barnet skapat (DjurIScen).
+import type { Sparad } from "./brygga.ts";
+import { PLATSDATA, type Plats } from "./platser.ts";
+
+/** Ljusets styrka i datan är 0–1; three.js-styrkan är den gånger LJUS_STYRKA (samma 8 som i B4.1-prompten). */
+export const LJUS_STYRKA = 8;
+export const MAX_LJUS = 4;
+
+export type Ljuskalla = { farg: string; intensitet: number; avstand: number; entiteter: string[] };
+
+/** Ytans bredd i världen (data/platser.json `yta.x`), som `radie` räknas mot. */
+export function ytansBredd(): number {
+  const [a, b] = PLATSDATA.yta.x;
+  return Math.abs(b - a);
+}
+
+/**
+ * Platsens ljuskälla ur `miljo.ljuskalla_skapad` = { radie, intensitet, farg, entiteter }.
+ * `radie` är andel av ytans bredd (0,24 × 11 ≈ 2,6 världsenheter), `intensitet` 0–1 (× LJUS_STYRKA).
+ * null när platsen inte har någon ljuskälla eller ingen entitet som lyser (ängen, eller en plats utan listan).
+ */
+export function ljuskallaFor(p: Pick<Plats, "miljo"> | undefined, bredd = ytansBredd()): Ljuskalla | null {
+  const l = p?.miljo?.ljuskalla_skapad as { radie?: unknown; intensitet?: unknown; farg?: unknown; entiteter?: unknown } | undefined;
+  if (!l || typeof l !== "object") return null;
+  const entiteter = Array.isArray(l.entiteter) ? l.entiteter.filter((e): e is string => typeof e === "string" && e.length > 0) : [];
+  if (!entiteter.length) return null;
+  const radie = typeof l.radie === "number" && l.radie > 0 ? l.radie : 0.24;
+  const intensitet = typeof l.intensitet === "number" && l.intensitet > 0 ? l.intensitet : 0.35;
+  const farg = typeof l.farg === "string" && /^#[0-9a-f]{6}$/i.test(l.farg) ? l.farg : "#FFD58A";
+  return { farg, intensitet: intensitet * LJUS_STYRKA, avstand: radie * bredd, entiteter };
+}
+
+/** Vad i skapelsen som lyser: kroppen själv ("en lykta") eller första saken den har med sig ("en kanin med en lykta"). */
+export function lyserVad(spec: Pick<Sparad, "kropp" | "tillbehor">, k: Pick<Ljuskalla, "entiteter">): string | null {
+  if (k.entiteter.includes(spec.kropp)) return spec.kropp;
+  return spec.tillbehor.map((t) => t.id).find((id) => k.entiteter.includes(id)) ?? null;
+}
+
+/** De högst `max` senast skapade skapelserna som lyser: uid → vad som lyser. Samma `skapad` → den senare i listan räknas som nyare. */
+export function valjLjus(djur: Pick<Sparad, "uid" | "kropp" | "tillbehor" | "skapad">[], k: Pick<Ljuskalla, "entiteter">, max = MAX_LJUS): Map<string, string> {
+  const lysande = djur
+    .map((d, i) => ({ d, i, vad: lyserVad(d, k) }))
+    .filter((x): x is { d: (typeof djur)[number]; i: number; vad: string } => x.vad !== null)
+    .sort((a, b) => b.d.skapad - a.d.skapad || b.i - a.i)
+    .slice(0, Math.max(0, max));
+  return new Map(lysande.map((x) => [x.d.uid, x.vad]));
+}
