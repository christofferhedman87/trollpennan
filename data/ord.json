  "djur_som_forled": "Ett djur som förled ger sin signatur till efterleden, t.ex. drakhäst = häst + vingar, fiskkatt = katt + fenor. Signaturen står på varje djur.",
  "okand_forled": "Om efterleden är känd men förleden inte: skapa efterleden, säg vänligt vilket ord Trollpennan inte kunde och spara förleden på önskelistan (t.ex. monsterkanin → kanin + \"monster\" sparas).",
  "exempel": {
   "eldkanin": "kanin + flammor",
   "regnbågsdrake": "drake + regnbåge",
   "guldfisk": "fisk + guldfärg + glans",
   "jättegroda": "groda, skala 1.8",
   "sjöhäst": "häst + fenor",
   "flygfisk": "fisk + vingar",
   "drakkatt": "katt + vingar (drakens signatur)",
   "ljuslila kanin": "kanin, ljusare lila",
   "eldregnbågsdrake": "drake + flammor + regnbåge"
  }
 },
 "stavning": {
  "regel": "Rätta aldrig tyst. Ett ord som inte finns jämförs med alla former i ordlistan.",
  "avstand": "Damerau-Levenshtein. Högst 1 för ord med 1–5 bokstäver, högst 2 för 6 eller fler.",
  "billiga_fel": "Kostar 0,5: a/å/ä, o/ö, e/ä, dubbel/enkel konsonant (kanin/kannin), ng/gn, j/g/hj/lj i början.",
  "svar": "Ett bästa förslag: \"Menade du kanin?\" med ordkortet. Två eller tre lika nära: visa upp till tre kort. Barnet trycker på kortet för att välja, eller \"Nej\" för en puff.",
  "guld": "Ett ord som rättats via \"Menade du …?\" räknas som hittat men blir inte guld."
 },
 "repliker": {
  "hej": [
   "Hej! Här kommer {formel}!",
   "Tjohej! Vad roligt att få vakna!",
   "Åh, vilken fin äng!"
  ],
  "vingar": [
   "Titta, jag kan flyga! Hoppas att du inte blir yr.",
   "Jag flög ända upp till molnen och tillbaka."
  ],
  "fenor": [
   "Plask! Dammen är min favoritplats.",
   "Vet du att jag kan hålla andan jättelänge?"
  ],
  "aura": [
   "När det blir mörkt lyser jag som en lykta.",
   "Jag lyser lite extra när jag är glad."
  ],
  "flammor": [
   "Akta dig, jag nyser eld när jag blir glad!",
   "Jag lovar att aldrig bränna blommorna."
  ],
  "fartlinjer": [
   "Ingen på hela ängen springer fortare än jag!",
   "Vill du tävla? Jag har redan vunnit."
  ],
  "studs": [
   "Boing, boing! Jag kan inte sluta hoppa.",
   "Jag studsade så högt att jag såg hela ängen."
  ],
  "utan_formaga": [
   "Jag gillar att ligga i gräset och titta på molnen.",
   "Kan du skriva en kompis åt mig?"
  ],
  "osynlig": [
   "Ser du mig? Inte? Bra, då leker vi kurragömma!"
  ],
  "sover": [
   "Nu går jag och vilar i Ordboken. Kalla på mig när du vill!"
  ]
 },
